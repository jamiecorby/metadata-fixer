    0x0311 => 'Pitch',
    0x0312 => 'Yaw',
    0x0313 => 'Roll',
    0x0314 => { Name => 'CX',   Unknown => 1 },
    0x0315 => { Name => 'CY',   Unknown => 1 },
    0x0316 => { Name => 'Rads', Unknown => 1 },
);

