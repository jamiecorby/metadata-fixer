    },
    {
        Name      => 'MakerNoteSony5',
        Condition => '$$self{Make}=~/^SONY/ and $$valPt!~/^\x01\x00/',
        Condition => q{
            ($$self{Make}=~/^SONY/ or ($$self{Make}=~/^HASSELBLAD/ and
            $$self{Model}=~/^(HV|Stellar|Lusso|Lunar)/)) and $$valPt!~/^\x01\x00/
        },
        SubDirectory => {
            TagTable  => 'Image::ExifTool::Sony::Main',
