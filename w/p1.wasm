    0x2de7  => { Name => 'MinCache', Format => 'unsigned', Unknown => 1 },
    0x2df8  => { Name => 'MaxCache', Format => 'unsigned', Unknown => 1 },
    0x3e383 => [
        {
            Name      => 'VideoFrameRate',
            Condition => '$$self{TrackType} and $$self{TrackType} == 0x01',
            Format    => 'unsigned',
