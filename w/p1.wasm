sub ProcessDICOM($$) {
    my ( $et, $dirInfo ) = @_;
    my $raf     = $$dirInfo{RAF};
    my $unknown = $et->Options('Unknown');
    my $verbose = $et->Options('Verbose');
    my ( $hdr, $buff, $implicit, $vr, $len );
    $raf->Read( $hdr, 12 ) == 12 or return 0;
    $raf->Seek( 128, 0 )         or return 0;
    $raf->Read( $buff, 4 ) == 4  or return 0;

    if ( $buff eq 'DICM' ) {
        SetByteOrder('II');
        $et->SetFileType('DICOM');
    }
    else {
        foreach ( 'II', 'MM', '' ) {
            return 0 unless $_;
            SetByteOrder($_);
            my $g = Get16u( \$hdr, 0 );
            next if $g < 2 or $g > 8 or $g & 0x01;
            my $e = Get16u( \$hdr, 2 );
            next if $e > 0x20;
            $vr = substr( $hdr, 4, 2 );
            if ( $vr =~ /^[A-Z]{2}$/ ) {
                $implicit = 0;
                if ( $vr32{$vr} ) {
                    next unless Get16u( \$hdr, 6 ) == 0;
                    $len = Get32u( \$hdr, 8 );
                }
                else {
                    next if $e == 0 and $vr ne 'UL';
                    $len = Get16u( \$hdr, 6 );
                }
            }
            else {
                $implicit = 1;
                $len      = Get32u( \$hdr, 4 );
            }
            next if $e == 0 and $len != 4;
            next if $len > 64;
            last;
        }
        $raf->Seek( 0, 0 ) or return 0;
        $et->SetFileType('ACR');
    }
    my $tagTablePtr = GetTagTable('Image::ExifTool::DICOM::Main');
    my $pos         = $raf->Tell();
    my $err         = 1;
    my ( $transferSyntax, $group2end );
    for ( ; ; ) {
        $raf->Read( $buff, 8 ) == 8 or $err = 0, last;
        $pos += 8;
        my $group = Get16u( \$buff, 0 );
        if (
            $transferSyntax
            and ( $group != 0x0002
                or ( $group2end and $pos > $group2end ) )
          )
        {
            unless (
                $transferSyntax =~ /^1\.2\.840\.10008\.1\.2(\.\d+)?(\.\d+)?/ )
            {
                $et->Warn("Unrecognized transfer syntax $transferSyntax");
                last;
            }
            if ( not $1 ) {
                $implicit = 1;
            }
            elsif ( $1 eq '.2' ) {
                SetByteOrder('MM');
                $group = Get16u( \$buff, 0 );
            }
            elsif ( $1 eq '.1' and $2 and $2 eq '.99' ) {
                if ( eval { require Compress::Zlib } ) {
                    my $wbits = -Compress::Zlib::MAX_WBITS();
                    my $inflate =
                      Compress::Zlib::inflateInit( -WindowBits => $wbits );
                    if ($inflate) {
                        $raf->Seek( -8, 1 ) or last;
                        my $data = '';
                        while ( $raf->Read( $buff, 65536 ) ) {
                            my ( $buf, $stat ) = $inflate->inflate($buff);
                            if (   $stat == Compress::Zlib::Z_OK()
                                or $stat == Compress::Zlib::Z_STREAM_END() )
                            {
                                $data .= $buf;
                                last if $stat == Compress::Zlib::Z_STREAM_END();
                            }
                            else {
                                $et->Warn(
                                    'Error inflating compressed data stream');
                                return 1;
                            }
                        }
                        last if length $data < 8;
                        $raf = File::RandomAccess->new( \$data );
                        $raf->Read( $buff, 8 ) == 8 or last;
                        $group = Get16u( \$buff, 0 );
                    }
                    else {
                        $et->Warn('Error initializing inflation');
                        return 1;
                    }
                }
                else {
                    $et->Warn(
'Install Compress::Zlib to decode compressed data stream'
                    );
                    return 1;
                }
            }
            undef $transferSyntax;
        }
        my $element = Get16u( \$buff, 2 );
        my $tag     = sprintf( '%.4X,%.4X', $group, $element );

        if ( $implicit or $implicitVR{$tag} ) {
            $vr  = '';
            $len = Get32u( \$buff, 4 );
        }
        else {
            $vr = substr( $buff, 4, 2 );
            last unless $vr =~ /^[A-Z]{2}$/;
            if ( $vr32{$vr} ) {
                $raf->Read( $buff, 4 ) == 4 or last;
                $pos += 4;
                $len = Get32u( \$buff, 0 );
                $len = 0 if $vr eq 'SQ';
            }
            else {
                $len = Get16u( \$buff, 6 );
            }
        }
        if ( $len == 0xffffffff ) {
            $len = 0;
            if ($verbose) {
                $et->VPrint( 0, "$$et{INDENT}+ [List of items]\n" );
                $$et{INDENT} .= '| ';
            }
        }
        if ($len) {
            $raf->Read( $buff, $len ) == $len or last;
            $pos += $len;
        }
        else {
            $buff = '';
        }

        my $tagInfo = $$tagTablePtr{$tag};
        unless ($tagInfo) {
            my $xx;
            if (
                   ( ( $xx = $tag ) =~ s/^(..)../$1xx/ and $$tagTablePtr{$xx} )
                or ( ( $xx = $tag ) =~ s/..$/xx/        and $$tagTablePtr{$xx} )
                or ( ( $xx = $tag ) =~ s/.(.)$/x$1/     and $$tagTablePtr{$xx} )
                or ( ( $xx = $tag ) =~ s/...(.)$/xxx$1/ and $$tagTablePtr{$xx} )
                or ( ( $xx = $tag ) =~ s/....$/xxxx/    and $$tagTablePtr{$xx} )
              )
            {
                $tag     = $xx;
                $tagInfo = $$tagTablePtr{$xx};
            }
            elsif ($unknown) {
                if ( $element == 0 ) {
                    $tagInfo = {
                        Name        => sprintf( "Group%.4X_Length",  $group ),
                        Description => sprintf( "Group %.4X Length", $group ),
                    };
                }
                else {
                    $tagInfo = {
                        Name => sprintf( "DICOM_%.4X_%.4X", $group, $element ),
                        Description =>
                          sprintf( "DICOM %.4X,%.4X", $group, $element ),
                    };
                }
                $$tagInfo{Unknown} = 1;
                AddTagToTable( $tagTablePtr, $tag, $tagInfo );
            }
        }
        $vr = $$tagInfo{VR} || '  ' if $tagInfo and not $vr;

        if ( $element == 0 ) {
            $vr = 'UL';
        }
        my $val;
        my $format = $dicomFormat{$vr};
        $buff =~ s/ $// unless $format or length($buff) & 0x01;
        if ( $len > 1024 ) {
            my $binData;
            my $lcTag = $tagInfo ? lc( $$tagInfo{Name} ) : 'unknown';
            if (
                $$et{REQ_TAG_LOOKUP}{$lcTag}
                or
                ( $$et{OPTIONS}{Binary} and not $$et{EXCL_TAG_LOOKUP}{$lcTag} )
              )
            {
                $binData = $buff;
            }
            else {
                $binData = "Binary data $len bytes";
            }
            $val = \$binData;
        }
        elsif ($format) {
            $val = ReadValue( \$buff, 0, $format, undef, $len );
        }
        else {
            $val    = $buff;
            $format = 'string';
            if ( $vr eq 'DA' ) {
                $val =~ s/^ *(\d{4})(\d{2})(\d{2})/$1:$2:$3/;
            }
            elsif ( $vr eq 'TM' ) {
                $val =~ s/^ *(\d{2})(\d{2})(\d{2}[^ ]*)/$1:$2:$3/;
            }
            elsif ( $vr eq 'DT' ) {
                $val =~
s/^ *(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})(\d{2}[^ ]*)/$1:$2:$3 $4:$5:$6/;
            }
            elsif ( $vr eq 'AT' and $len == 4 ) {
                my ( $g, $e ) = ( Get16u( \$buff, 0 ), Get16u( \$buff, 2 ) );
                $val = sprintf( '%.4X,%.4X', $g, $e );
            }
            elsif ( $vr eq 'UI' ) {
                $val =~ s/\0.*//s;
                $$tagInfo{PrintConv} = \%uid if $uid{$val} and $tagInfo;
            }
            elsif ( $vr =~ /^(AE|CS|DS|IS|LO|PN|SH)$/ ) {
                $val =~ s/ +$//;
                $val =~ s/^ +//;
            }
            elsif ( $vr =~ /^(LT|ST|UT)$/ ) {
                $val =~ s/ +$//;
            }
        }
        if ( $group == 0x0002 ) {
            $element == 0x0000 and $group2end      = $pos + $val;
            $element == 0x0010 and $transferSyntax = $val;
        }

        $et->HandleTag(
            $tagTablePtr, $tag, $val,
            DataPt  => \$buff,
            DataPos => $pos - $len,
            Format  => $format,
            Start   => 0,
            Size    => $len,
            Extra   => " ($vr)",
        );

        $$et{INDENT} =~ s/..$// if $verbose and $tag eq 'FFFE,E00D';
    }
    $err and $et->Warn('Error reading DICOM file (corrupted?)');
    return 1;
}

1;

__END__



package Image::ExifTool::DJI;

use strict;
use vars            qw($VERSION %knownProtocol);
use Image::ExifTool qw(:DataAccess :Utils);
use Image::ExifTool::Exif;
use Image::ExifTool::XMP;
use Image::ExifTool::GPS;
use Image::ExifTool::Protobuf;

$VERSION = '1.16';

sub ProcessDJIInfo($$$);
sub ProcessSettings($$$);

%knownProtocol = (
    'dvtm_ac203.proto'     => 1,
    'dvtm_ac204.proto'     => 1,
    'dvtm_AVATA2.proto'    => 1,
    'dvtm_wm265e.proto'    => 1,
    'dvtm_pm320.proto'     => 1,
    'dvtm_Mini4_Pro.proto' => 1,
    'dvtm_dji_neo.proto'   => 1,
    'dvtm_Air3.proto'      => 1,
    'dvtm_Air3s.proto'     => 1,
    'dvtm_PP-101.proto'    => 1,
    'dvtm_oq101.proto'     => 1,
    'dvtm_wa345e.proto'    => 1,
    'dvtm_wm261.proto'     => 1,
);

my %convFloat2 = (
    PrintConv    => 'sprintf("%+.2f", $val)',
    PrintConvInv => '$val',
);

%Image::ExifTool::DJI::Main = (
    WRITE_PROC => \&Image::ExifTool::Exif::WriteExif,
    CHECK_PROC => \&Image::ExifTool::Exif::CheckExif,
    GROUPS     => { 0 => 'MakerNotes', 2 => 'Camera' },
    NOTES      => q{
        This table lists tags found in the maker notes of images from some DJI
        Phantom drones.
    },
    0x01 => { Name => 'Make', Writable => 'string' },
    0x03 => { Name => 'SpeedX',      Writable => 'float', %convFloat2 },
    0x04 => { Name => 'SpeedY',      Writable => 'float', %convFloat2 },
    0x05 => { Name => 'SpeedZ',      Writable => 'float', %convFloat2 },
    0x06 => { Name => 'Pitch',       Writable => 'float', %convFloat2 },
    0x07 => { Name => 'Yaw',         Writable => 'float', %convFloat2 },
    0x08 => { Name => 'Roll',        Writable => 'float', %convFloat2 },
    0x09 => { Name => 'CameraPitch', Writable => 'float', %convFloat2 },
    0x0a => { Name => 'CameraYaw',   Writable => 'float', %convFloat2 },
    0x0b => { Name => 'CameraRoll',  Writable => 'float', %convFloat2 },
);

%Image::ExifTool::DJI::Info = (
    PROCESS_PROC                => \&ProcessDJIInfo,
    GROUPS                      => { 0 => 'MakerNotes', 2 => 'Camera' },
    NOTES                       => 'Tags written by some DJI drones.',
    VARS                        => { LONG_TAGS => 2 },
    ae_dbg_info                 => { Name      => 'AEDebugInfo' },
    ae_histogram_info           => { Name      => 'AEHistogramInfo' },
    ae_local_histogram          => { Name      => 'AELocalHistogram' },
    ae_liveview_histogram_info  => { Name      => 'AELiveViewHistogramInfo' },
    ae_liveview_local_histogram => { Name      => 'AELiveViewLocalHistogram' },
    awb_dbg_info                => { Name      => 'AWBDebugInfo' },
    af_dbg_info                 => { Name      => 'AFDebugInfo' },
    hiso                        => { Name      => 'Histogram' },
    xidiri                      => { Name      => 'Xidiri' },
    'GimbalDegree(Y,P,R)'       => { Name      => 'GimbalDegree' },
    'FlightDegree(Y,P,R)'       => { Name      => 'FlightDegree' },
    adj_dbg_info                => { Name      => 'ADJDebugInfo' },
    sensor_id                   => { Name      => 'SensorID' },
    'FlightSpeed(X,Y,Z)'        => { Name      => 'FlightSpeed' },
