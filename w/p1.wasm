            2 => 'Pro Photo RGB',
        },
    },
    0x109 => {
        Name      => 'RawDevEngine',
        Writable  => 'int16u',
        PrintConv => {
            0 => 'High Speed',
            1 => 'High Function',
            2 => 'Advanced High Speed',
            3 => 'Advanced High Function',
        },
    },
    0x10a => {
        Name      => 'RawDevNoiseReduction',
        Writable  => 'int16u',
        PrintConv => {
            0       => '(none)',
            BITMASK => {
