            return $val - 273.15 if $$self{Reading2Units} == 0x0d and $$self{Reading2Description} != 11;
            return $val *= 1000 if $$self{Reading2Units} == 0x24;
            return $val;
        },
    },
    226 => {
        Name       => 'Reading3Units',
        DataMember => 'Reading3Units',
        RawConv    => '$$self{Reading3Units} = $val',
        PrintHex   => 1,
        PrintConv  => {
