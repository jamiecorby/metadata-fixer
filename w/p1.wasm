    OilTemp                          => {},
    OutsideAirTemperature            => {},
    RecordingEventOdometer           => {},
    RFTyrePressure                   => {},
    RFTyreTemp                       => {},
    RPM                              => {},
    RRTyrePressure                   => {},
    RRTyreTemp                       => {},
    Speed                            => { Groups => { 2 => 'Location' } },
    SpeedControlResponse             => {},
