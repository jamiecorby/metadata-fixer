    15.1 => {
        Name      => 'AELockButton',
        Mask      => 0x38,
        PrintConv => {
            0 => 'AE/AF Lock',
            1 => 'AE Lock Only',
            2 => 'AF Lock Only',
            3 => 'AE Lock (hold)',
            4 => 'AF-ON',
        },
    },
    16.1 => {
        Name      => 'ShutterReleaseButtonAE-L',
        Mask      => 0x02,
        PrintConv => \%offOn,
    },
    16.2 => {
        Name      => 'CommandDialsReverseRotation',
        Mask      => 0x80,
        PrintConv => \%noYes,
    },
    17.1 => {
        Name      => 'MeteringTime',
        Mask      => 0x70,
        PrintConv => {
            0 => '4 s',
            1 => '8 s',
            2 => '20 s',
            3 => '1 min',
            4 => '30 min',
        },
    },
    17.2 => {
        Name      => 'RemoteOnDuration',
        Mask      => 0x03,
        PrintConv => {
            0 => '1 min',
            1 => '5 min',
            2 => '10 min',
            3 => '15 min',
        },
    },
    18.1 => {
        Name      => 'SelfTimerTime',
        Mask      => 0xc0,
        PrintConv => {
            0 => '2 s',
            1 => '5 s',
            2 => '10 s',
            3 => '20 s',
        },
    },
    18.2 => {
        Name => 'SelfTimerShotCount',
        Mask => 0x1e,
    },
    19.1 => {
        Name      => 'ImageReviewTime',
        Mask      => 0xe0,
        PrintConv => {
            0 => '4 s',
            1 => '8 s',
            2 => '20 s',
            3 => '1 min',
            4 => '10 min',
        },
    },
    20.1 => {
        Name      => 'PlaybackMenusTime',
        Mask      => 0xe0,
        PrintConv => {
            0 => '8 s',
            1 => '12 s',
            2 => '20 s',
            3 => '1 min',
            4 => '10 min',
        },
    },
    22.1 => {
        Name      => 'InternalFlash',
        Mask      => 0xc0,
        PrintConv => {
            0 => 'TTL',
            1 => 'Manual',
        },
    },
    22.2 => {
        Name         => 'ManualFlashOutput',
        Mask         => 0x1f,
        ValueConv    => '2 ** (-$val/3)',
        ValueConvInv => '$val > 0 ? -3*log($val)/log(2) : 0',
        PrintConv    => q{
            return 'Full' if $val > 0.99;
            Image::ExifTool::Exif::PrintExposureTime($val);
        },
        PrintConvInv =>
          '$val=~/F/i ? 1 : Image::ExifTool::Exif::ConvertFraction($val)',
    },
    32.1 => {
        Name      => 'LiveViewAF',
        Mask      => 0x60,
        PrintConv => {
            0 => 'Face Priority',
            1 => 'Wide Area',
            2 => 'Normal Area',
            3 => 'Subject Tracking',
        },
    },
);

