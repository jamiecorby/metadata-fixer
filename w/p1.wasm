    },
    0x8008 => {

        Name      => 'TextStamp',
        Writable  => 'int16u',
        PrintConv => { 1 => 'Off', 2 => 'On' },
    },
    0x8009 => {

        Name      => 'TextStamp',
        Writable  => 'int16u',
        PrintConv => { 1 => 'Off', 2 => 'On' },
    },
    0x8010 => {
        Name         => 'BabyAge',
        Writable     => 'string',
        Notes        => 'or pet age',
        PrintConv    => '$val eq "9999:99:99 00:00:00" ? "(not set)" : $val',
