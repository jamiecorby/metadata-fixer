'$$valPt=~/^\x78\x3f\xc7\x83\x0c\x95\x4b\x00\x8c\xc7\xac\xf1\xec\xb4\xd3\x9a/s',
            Unknown   => 1,
            ValueConv => 'join " ", unpack "x20N4xZ*", $val',
