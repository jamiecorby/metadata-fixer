        SubDirectory => { TagTable => 'Image::ExifTool::PhaseOne::Main' },
        PutFirst     => 1,
    },
    {
        Name      => 'MakerNoteReconyxHyperFire',
        Condition => q{
            $$valPt =~ /^\x01\xf1([\x02\x03]\x00)?/ and
