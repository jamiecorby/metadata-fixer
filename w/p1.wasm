my %cropHiSpeed = (
    0     => 'Off',
    1     => '1.3x Crop',
    2     => 'DX Crop',
    3     => '5:4 Crop',
    4     => '3:2 Crop',
    6     => '16:9 Crop',
    8     => '2.7x Crop',
    9     => 'DX Movie 16:9 Crop',
    10    => '1.3x Movie Crop',
    11    => 'FX Uncropped',
    12    => 'DX Uncropped',
    13    => '2.8x Movie Crop',
    14    => '1.4x Movie Crop',
    15    => '1.5x Movie Crop',
    17    => 'FX 1:1 Crop',
    18    => 'DX 1:1 Crop',
    OTHER => sub {
        my ( $val, $inv, $conv ) = @_;
        return undef if $inv;
        my @a = split ' ', $val;
        return "Unknown ($val)" unless @a == 7;
        $a[0] = $$conv{ $a[0] } || "Unknown ($a[0])";
        return
          "$a[0] ($a[1]x$a[2] cropped to $a[3]x$a[4] at pixel $a[5],$a[6])";
    },
);

