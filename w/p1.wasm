    },
    FirmwareVersion => {},
    FocusMode       => {},
    ISO             => { Writable => 'int16u' },
    ISOSetting      => {
        Writable => 'int16u',
        Notes    => '0 = Auto, otherwise manual ISO speed setting',
    },
    ImageNumber  => { Writable => 'int32u' },
    ImageQuality => { Notes    => 'Economy, Normal, Fine, Super Fine or Raw' },
    ImageStabilization => { Writable => 'int8u', %offOn },
    Lens               => {
