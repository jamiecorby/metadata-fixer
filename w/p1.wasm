    662 => {
        Name      => 'WB_RBLevelsCloudy',
        Format    => 'int16u[14]',
        Protected => 1,
    },
    676 => {
        Name      => 'WB_RBLevelsFlash',
        Format    => 'int16u[14]',
        Protected => 1,
    },
    690 => {
        Name      => 'WB_RBLevelsShade',
        Condition => '$$self{Model} ne "E8700"',
        Notes     => 'not valid for E8700',
        Format    => 'int16u[14]',
        Protected => 1,
    },
);

my %nrwLevels = (
    Format       => 'int32u[4]',
    Protected    => 1,
    ValueConv    => 'my @a=split " ",$val;$a[0]*=2;$a[3]*=2;"@a"',
    ValueConvInv => 'my @a=split " ",$val;$a[0]/=2;$a[3]/=2;"@a"',
);

