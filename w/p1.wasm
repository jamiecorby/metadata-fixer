        RawConv   => '$val ? $val : undef',
    },
    0x1c => [
        {
            Name      => 'ContrastDetectAFInFocus',
            Condition => '$$self{AFDetectionMethod} == 1',
            PrintConv => { 0 => 'No', 1 => 'Yes' },
        },
        {
            Name         => 'AFPointsSelected',
            Condition    => '$$self{FocusPointSchema} == 7',
