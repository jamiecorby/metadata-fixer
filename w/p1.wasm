              '$$self{FirmwareVersion} and $$self{FirmwareVersion} lt "02.00"',
            Format       => 'int32u',
            Notes        => 'Firmware versions 1.00 and 1.10',
            SubDirectory => {
                TagTable => 'Image::ExifTool::Nikon::MenuSettingsZ8v1',
                Start    => '$dirStart + $val',
            },
        },
        {
            Name      => 'MenuSettingsOffsetZ8v2',
            Condition =>
              '$$self{FirmwareVersion} and $$self{FirmwareVersion} ge "02.00"',
            Notes        => 'Firmware version 2.00 and 2.10',
            Format       => 'int32u',
            SubDirectory => {
                TagTable => 'Image::ExifTool::Nikon::MenuSettingsZ8v2',
                Start    => '$dirStart + $val',
            },
        },
    ],
);

