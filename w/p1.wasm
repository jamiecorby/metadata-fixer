        },
        {
            Name      => 'ContrastMode',
            Condition => '$$self{Model} =~ /^DMC-(GF\d+|G2)$/',
            Notes     =>
              'these values are used by the G2, GF1, GF2, GF3, GF5 and GF6',
            Writable  => 'int16u',
            PrintConv => {
                0 => '-2',
                1 => '-1',
                2 => 'Normal',
                3 => '+1',
                4 => '+2',
                5   => 'Normal 2',
                7   => 'Nature (Color Film)',
                9   => 'Expressive',
                12  => 'Smooth (Color Film) or Pure (My Color)',
                17  => 'Dynamic (B&W Film)',
                22  => 'Smooth (B&W Film)',
