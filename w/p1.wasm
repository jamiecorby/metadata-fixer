            ByteOrder => 'Unknown',
        },
    },
    {
        Name => 'MakerNoteSanyoPatch',
        Condition    => '$$self{Make}=~/^SANYO/',
        SubDirectory => {
            TagTable   => 'Image::ExifTool::Sanyo::Main',
            Validate   => '$val =~ /^SANYO/',
            Start      => '$valuePtr + 8',
            ByteOrder  => 'Unknown',
            FixOffsets =>
'Image::ExifTool::Sanyo::FixOffsets($valuePtr, $valEnd, $size, $tagID, $wFlag)',
