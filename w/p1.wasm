        },
    },
    3.1 => {
        Name      => 'FileNumberSequence',
        Mask      => 0x08,
        PrintConv => \%onOff,
    },
    4.1 => {
        Name      => 'RangeFinder',
        Mask      => 0x10,
        PrintConv => \%offOn,
    },
    4.2 => {
        Name      => 'DateImprint',
