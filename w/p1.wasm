    },
    {
        Name => 'MakerNotePanasonic',
        Condition    => '$$valPt=~/^Panasonic/ and $$self{Model} ne "DC-FT7"',
        SubDirectory => {
            TagTable  => 'Image::ExifTool::Panasonic::Main',
            Start     => '$valuePtr + 12',
