package Image::ExifTool::Red;

use strict;
use vars            qw($VERSION);
use Image::ExifTool qw(:DataAccess :Utils);

$VERSION = '1.02';

sub ProcessR3D($$);

my %redFormat = (
    0 => 'int8u',
    1 => 'string',
    2 => 'float',
    3 => 'int8u',
    4 => 'int16u',
    5 => 'int8s',
    6 => 'int32s',
    7 => 'undef',
    8 => 'int32u',
    9 => 'undef',
);

my $errTrunc = 'Truncated R3D file';

%Image::ExifTool::Red::Main = (
    GROUPS => { 2 => 'Camera' },
    NOTES  => 'Tags extracted from Redcode R3D video files.',
    VARS   => { ALPHA_FIRST => 1 },

    RED1 => {
        Name         => 'Red1Header',
        SubDirectory => { TagTable => 'Image::ExifTool::Red::RED1' }
    },
    RED2 => {
        Name         => 'Red2Header',
        SubDirectory => { TagTable => 'Image::ExifTool::Red::RED2' }
    },

    0x1000 => 'StartEdgeCode',
    0x1001 => { Name => 'StartTimecode', Groups => { 2 => 'Time' } },
    0x1002 => {
        Name   => 'OtherDate1',
        Groups => { 2 => 'Time' },
        ValueConv =>
          '$val =~ s/(\d{4})_(\d{2})_/$1:$2:/; $val =~ tr/_/ /; $val',
    },
    0x1003 => {
        Name      => 'OtherDate2',
        Groups    => { 2 => 'Time' },
        ValueConv =>
          '$val =~ s/(\d{4})_(\d{2})_/$1:$2:/; $val =~ tr/_/ /; $val',
    },
    0x1004 => {
        Name      => 'OtherDate3',
        Groups    => { 2 => 'Time' },
        ValueConv =>
          '$val =~ s/(\d{4})_(\d{2})_/$1:$2:/; $val =~ tr/_/ /; $val',
    },
    0x1005 => {
        Name        => 'DateTimeOriginal',
        Description => 'Date/Time Original',
        Groups      => { 2 => 'Time' },
        ValueConv   =>
'$val =~ s/(\d{4})(\d{2})(\d{2})(\d{2})(\d{2})/$1:$2:$3 $4:$5:/; $val',
        PrintConv => '$self->ConvertDateTime($val)',
    },
    0x1006 => 'SerialNumber',
    0x1019 => 'CameraType',
    0x101a => { Name => 'ReelNumber', Groups => { 2 => 'Video' } },
    0x101b => { Name => 'Take',       Groups => { 2 => 'Video' } },
    0x1023 => {
        Name      => 'DateCreated',
        Groups    => { 2 => 'Time' },
        ValueConv => '$val =~ s/(\d{4})(\d{2})/$1:$2:/; $val',
    },
    0x1024 => {
        Name      => 'TimeCreated',
        Groups    => { 2 => 'Time' },
        ValueConv => '$val =~ s/(\d{2})(\d{2})/$1:$2:/; $val',
    },
    0x1025 => 'FirmwareVersion',
    0x1029 => { Name => 'ReelTimecode', Groups => { 2 => 'Time' } },
    0x102a => 'StorageType',
    0x1030 => {
        Name      => 'StorageFormatDate',
        Groups    => { 2 => 'Time' },
        ValueConv => '$val =~ s/(\d{4})(\d{2})/$1:$2:/; $val',
    },
    0x1031 => {
        Name      => 'StorageFormatTime',
        Groups    => { 2 => 'Time' },
        ValueConv => '$val =~ s/(\d{2})(\d{2})/$1:$2:/; $val',
    },
    0x1032 => 'StorageSerialNumber',
    0x1033 => 'StorageModel',
    0x1036 => 'AspectRatio',

    0x1042 => 'Revision',

    0x1056 => 'OriginalFileName',
    0x106e => 'LensMake',
    0x106f => 'LensNumber',
    0x1070 => 'LensModel',
    0x1071 => {
        Name        => 'Model',
        Description => 'Camera Model Name',
    },
    0x107c => { Name => 'CameraOperator', Groups => { 2 => 'Author' } },
    0x1086 => {
        Name   => 'VideoFormat',
        Groups => { 2 => 'Video' },
    },
    0x1096 => 'Filter',
    0x10a0 => 'Brain',
    0x10a1 => 'Sensor',
    0x10be => 'Quality',
    0x200d => 'ColorTemperature',
    0x204b => 'RGBCurves',
    0x2066 => {
        Name      => 'OriginalFrameRate',
        Groups    => { 2 => 'Video' },
        PrintConv => 'int($val * 1000 + 0.5) / 1000',
    },
    0x4037 => { Name => 'CropArea' },
    0x403b => 'ISO',
    0x406a => { Name => 'FNumber', ValueConv => '$val / 10' },
    0x406b => 'FocalLength',
    0x606c => {
        Name      => 'FocusDistance',
        ValueConv => '$val/1000',
        PrintConv => '"$val m"'
    },
);

%Image::ExifTool::Red::RED1 = (
    GROUPS       => { 2 => 'Video' },
    PROCESS_PROC => \&Image::ExifTool::ProcessBinaryData,
    NOTES        => 'Redcode version 1 header.',
    0x07 => { Name => 'RedcodeVersion', Format => 'string[1]' },

    0x36 => { Name => 'ImageWidth',  Format => 'int16u' },
    0x3a => { Name => 'ImageHeight', Format => 'int16u' },
    0x3e => {
        Name      => 'FrameRate',
        Format    => 'rational32u',
        PrintConv => 'int($val * 1000 + 0.5) / 1000',
    },
    0x43 => { Name => 'OriginalFileName', Format => 'string[32]' },
);

%Image::ExifTool::Red::RED2 = (
    GROUPS       => { 2 => 'Video' },
    PROCESS_PROC => \&Image::ExifTool::ProcessBinaryData,
    NOTES        => 'Redcode version 2 header.',
    0x07 => { Name => 'RedcodeVersion', Format => 'string[1]' },
    0x4c => { Name => 'ImageWidth',  Format => 'int32u' },
    0x50 => { Name => 'ImageHeight', Format => 'int32u' },
    0x56 => {
        Name      => 'FrameRate',
        Format    => 'int16u[3]',
        ValueConv =>
          'my @a = split " ",$val; ($a[1] * 0x10000 + $a[2]) / $a[0]',
        PrintConv => 'int($val * 1000 + 0.5) / 1000',
    },
);

sub ProcessR3D($$) {
    my ( $et, $dirInfo ) = @_;
    my $raf = $$dirInfo{RAF};
    my ( $buff, $buf2, $pos, $dirLen, $dirEnd );
    my $verbose = $et->Options('Verbose');

    return 0 unless $raf->Read( $buff, 8 ) == 8 and $buff =~ /^\0\0..RED(1|2)/s;
    my $ver  = $1;
    my $size = unpack( 'N', $buff );
    return 0 if $size < 8;

    $et->SetFileType();
    SetByteOrder('MM');
    my $tagTablePtr = GetTagTable('Image::ExifTool::Red::Main');
    my $dataPos     = 0;

    $raf->Read( $buf2, $size - 8 ) == $size - 8 or return $et->Warn($errTrunc);
    $buff .= $buf2;

    $et->HandleTag( $tagTablePtr, "RED$ver", undef, DataPt => \$buff );

    if ( $ver eq '1' ) {
        $raf->Read( $buff, 0x10000 ) or return $et->Warn($errTrunc);
        $dataPos += $size;
        $pos = 0x22;
    }
    else {
        $pos = 0x44;
        length($buff) < $pos and return $et->Warn($errTrunc);
        $pos += Get8u( \$buff, 0x40 ) * 0x18;
        $pos += Get8u( \$buff, 0x41 ) * 0x14;
        $pos += Get8u( \$buff, 0x42 ) * 0x10;
    }
    if ( $pos + 8 > length $buff ) {
        $dirLen = 0;
    }
    else {
        $dirLen = Get16u( \$buff, $pos );
        $pos += 2;
    }
    if ( $dirLen < 300 or $dirLen >= 2048 or $pos + $dirLen > length $buff ) {
        $buff =~ /\0\x0f\x10[\0\x06]/g
          or return $et->Warn(
            "Can't find Red directory. Please submit sample for testing");
        $pos    = pos($buff) - 4;
        $dirEnd = length $buff;
        undef $dirLen;
        $et->Warn(
            'This R3D file is different. Please submit a sample for testing');
    }
    else {
        $dirEnd = $pos + $dirLen;
    }
    $$et{INDENT} .= '| ', $et->VerboseDir( 'Red', undef, $dirLen ) if $verbose;

    while ( $pos + 4 <= $dirEnd ) {
        my $len = Get16u( \$buff, $pos );
        last if $len < 4 or $pos + $len > $dirEnd;
        my $tag = Get16u( \$buff, $pos + 2 );
        my $fmt = $redFormat{ $tag >> 12 };
        $fmt or $dirLen && $et->Warn('Unknown format code'), last;
        $et->HandleTag(
            $tagTablePtr, $tag, undef,
            DataPt  => \$buff,
            DataPos => $dataPos,
            Start   => $pos + 4,
            Size    => $len - 4,
            Format  => $fmt,
        );
        $pos += $len;
    }
    $$et{INDENT} = substr( $$et{INDENT}, 0, -2 ) if $verbose;

    return 1;
}

1;

__END__



package Image::ExifTool::Ricoh;

