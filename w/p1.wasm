my %digitalFilter = (
    Format  => 'undef[17]',
    RawConv =>
'($val!~/^\\0/ or $$self{OPTIONS}{Unknown}) ? join(" ",unpack("Cc*",$val)) : undef',
    SeparateTable => 'DigitalFilter',
    ValueConvInv  => q{
        return "\0" x 17 if $val eq "0";
        $val = pack("Cc*", $val=~/[-+]?\d+/g);
        length($val)==17 or warn("Expecting 17 values\n"), return undef;
        return $val;
    },
    PrintConv => {
        OTHER => \&PrintFilter,
        0     => 'Off',
        1     => 'Base Parameter Adjust',
        2     => 'Soft Focus',
        3     => 'High Contrast',
        4     => 'Color Filter',
        5     => 'Extract Color',
        6     => 'Monochrome',
        7     => 'Slim',
        9     => 'Fisheye',
        10    => 'Toy Camera',
        11    => 'Retro',
        12    => 'Pastel',
        13    => 'Water Color',
        14    => 'HDR',
        16    => 'Miniature',
        17    => 'Starburst',
        18    => 'Posterization',
