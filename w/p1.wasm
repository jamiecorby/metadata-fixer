%Image::ExifTool::NikonCustom::SettingsD700 = (
    PROCESS_PROC => \&Image::ExifTool::ProcessBinaryData,
    WRITE_PROC   => \&Image::ExifTool::WriteBinaryData,
    CHECK_PROC   => \&Image::ExifTool::CheckBinaryData,
    WRITABLE     => 1,
    FIRST_ENTRY  => 0,
    DATAMEMBER   => [16.1],
    GROUPS       => { 0 => 'MakerNotes', 2 => 'Camera' },
    NOTES        => 'Custom settings for the D700.',
    0.1          => {
        Name      => 'CustomSettingsBank',
        Mask      => 0x03,
        PrintConv => {
            0 => 'A',
            1 => 'B',
            2 => 'C',
            3 => 'D',
        },
    },
    0.2 => {
        Name  => 'CustomSettingsAllDefault',
        Notes =>
'"No" if any custom setting for this bank was changed from the default',
        Mask      => 0x80,
        PrintConv => { 0 => 'Yes', 1 => 'No' },
    },
    1.1 => {
        Name      => 'AF-CPrioritySelection',
        Mask      => 0xc0,
        PrintConv => {
            0 => 'Release',
            1 => 'Release + Focus',
            2 => 'Focus',
        },
    },
    1.2 => {
        Name      => 'AF-SPrioritySelection',
        Mask      => 0x20,
        PrintConv => {
            0 => 'Focus',
            1 => 'Release',
        },
    },
    1.3 => {
        Name      => 'AFPointSelection',
        Mask      => 0x10,
        PrintConv => {
            0 => '51 Points',
            1 => '11 Points',
        },
    },
    1.4 => {
        Name      => 'DynamicAFArea',
        Mask      => 0x0c,
        PrintConv => {
            0 => '9 Points',
            1 => '21 Points',
            2 => '51 Points',
            3 => '51 Points (3D-tracking)',
        },
    },
    2.1 => {
        Name      => 'AFActivation',
        Mask      => 0x80,
        PrintConv => {
            0 => 'Shutter/AF-On',
            1 => 'AF-On Only',
        },
    },
    2.2 => {
        Name      => 'FocusPointWrap',
        Mask      => 0x08,
        PrintConv => {
            0 => 'No Wrap',
            1 => 'Wrap',
        },
    },
    2.3 => {
        Name      => 'AFPointIllumination',
        Mask      => 0x06,
        PrintConv => {
            0 => 'Auto',
            1 => 'Off',
            2 => 'On',
        },
    },
    2.4 => {
        Name      => 'AFAssist',
        Mask      => 0x01,
        PrintConv => \%onOff,
    },
    3.1 => {
        Name      => 'FocusTrackingLockOn',
        Mask      => 0x07,
        PrintConv => {
            0 => '3 Normal',
            1 => '4',
            2 => '5 Long',
            3 => '2',
            4 => '1 Short',
            5 => 'Off',
        },
    },
    3.2 => {
        Name      => 'AF-OnForMB-D10',
        Mask      => 0x70,
        PrintConv => {
            0 => 'AF-On',
            1 => 'AE/AF Lock',
            2 => 'AE Lock Only',
            3 => 'AE Lock (reset on release)',
            4 => 'AE Lock (hold)',
            5 => 'AF Lock Only',
            6 => 'Same as FUNC Button',
        },
    },
    4.1 => {
        Name      => 'ISOStepSize',
        Mask      => 0xc0,
        PrintConv => {
            0 => '1/3 EV',
            1 => '1/2 EV',
            2 => '1 EV',
        },
    },
    4.2 => {
        Name      => 'ExposureControlStepSize',
        Mask      => 0x30,
        PrintConv => {
            0 => '1/3 EV',
            1 => '1/2 EV',
            2 => '1 EV',
        },
    },
    4.3 => {
        Name      => 'ExposureCompStepSize',
        Mask      => 0x0c,
        PrintConv => {
