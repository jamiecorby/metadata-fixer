    },
    576 => {
        Name      => 'MovieVignetteControlSameAsPhoto',
        Unknown   => 1,
        PrintConv => \%noYes
    },
    577 => {
        Name      => 'MovieDiffractionCompensation',
        Unknown   => 1,
        PrintConv => \%offOn
    },
    578 => {
        Name      => 'MovieAutoDistortionControl',
        Unknown   => 1,
        PrintConv => \%offOn
    },
    584 =>
      { Name => 'MovieFocusMode', PrintConv => \%focusModeZ7, Unknown => 1 },
    590 => {
        Name      => 'MovieVibrationReduction',
        Unknown   => 1,
        PrintConv => {
            0 => 'Off',
