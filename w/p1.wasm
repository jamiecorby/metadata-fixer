    GROUPS       => { 0 => 'MakerNotes', 2 => 'Camera' },
    NOTES        => 'Custom settings for the D800 and D800E.',
    12.1         => {
        Name      => 'AutoBracketingSet',
        Mask      => 0xe0,
        PrintConv => {
