use Image::ExifTool qw(:DataAccess :Utils);

$VERSION = '1.31';

my %streamType = (
    0x00 => 'Reserved',
    0x01 => 'MPEG-1 Video',
    0x02 => 'MPEG-2 Video',
    0x03 => 'MPEG-1 Audio',
