    '7 1'  => '7.01 (SB-910)',
    '14 3' => '14.03 (SB-5000)',
    OTHER  => sub {
        my ( $val, $inv ) = @_;
        return sprintf( '%d.%.2d (Unknown model)', split( ' ', $val ) )
