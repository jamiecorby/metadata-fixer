    WRITABLE   => 1,
    0x0001     => { Name => 'MakerNoteType', Writable => 'string' },
    0x0002     => {
        Name     => 'FirmwareVersion',
        Writable => 'string',
        PrintConv    => '$val=~/^Rev(\d+)$/ ? sprintf("%.2f",$1/100) : $val',
        PrintConvInv =>
          '$val=~/^(\d+)\.(\d+)$/ ? sprintf("Rev%.2d%.2d",$1,$2) : $val',
