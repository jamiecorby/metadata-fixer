            1 => 'Active D-Lighting',
            2 => 'WB Bracketing',
        },
    },
    12.1 => {
        Name      => 'TimerFunctionButton',
        Mask      => 0x38,
        PrintConv => {
            0 => 'Self-timer',
            1 => 'Release Mode',
