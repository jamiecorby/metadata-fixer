        },
    },
    0x203 => { Name => 'ExposureShift', Writable => 'rational64s' },
    0x204 => {
        Name      => 'NDFilter',
        PrintConv => \%offOn,
    },
    0x300 => {
        Name      => 'MacroMode',
        Writable  => 'int16u',
        PrintConv => {
            0 => 'Off',
            1 => 'On',
            2 => 'Super Macro',
        },
    },
    0x301 => {
        Name      => 'FocusMode',
        Writable  => 'int16u',
        Count     => -1,
        Notes     => '1 or 2 values',
        PrintConv => [
            {
                0  => 'Single AF',
                1  => 'Sequential shooting AF',
                2  => 'Continuous AF',
                3  => 'Multi AF',
                4  => 'Face Detect',
                10 => 'MF',
            },
            {
                0       => '(none)',
                BITMASK => {
                    0 => 'S-AF',
                    2 => 'C-AF',
                    4 => 'MF',
                    5 => 'Face Detect',
                    6 => 'Imager AF',
                    7 => 'Live View Magnification Frame',
                    8 => 'AF sensor',
                    9 => 'Starry Sky AF',
                },
            }
        ],
    },
    0x302 => {
        Name      => 'FocusProcess',
        Writable  => 'int16u',
        Count     => -1,
        Notes     => '1 or 2 values',
        PrintConv => [
            {
                0 => 'AF Not Used',
                1 => 'AF Used',
            }
        ],
    },
    0x303 => {
        Name      => 'AFSearch',
        Writable  => 'int16u',
        PrintConv => {
            0 => 'Not Ready',
            1 => 'Ready',
        },
    },
    0x304 => {
        Name      => 'AFAreas',
        Notes     => 'coordinates range from 0 to 255',
        Writable  => 'int32u',
        Count     => 64,
        PrintConv => 'Image::ExifTool::Olympus::PrintAFAreas($val)',
    },
    0x0305 => {
        Name         => 'AFPointSelected',
        Notes        => 'coordinates expressed as a percent',
        Writable     => 'rational64s',
        Count        => 5,
        ValueConv    => '$val =~ s/\S* //; $val',
        ValueConvInv => '"undef $val"',
        PrintConv    => q{
            return 'n/a' if $val =~ /undef/;
            sprintf("(%d%%,%d%%) (%d%%,%d%%)", map {$_ * 100} split(" ",$val));
        },
        PrintConvInv => q{
            return 'undef undef undef undef' if $val eq 'n/a';
            my @nums = $val =~ /\d+(?:\.\d+)?/g;
            return undef unless @nums == 4;
            join ' ', map {$_ / 100} @nums;
        },
    },
    0x306 => {
        Name      => 'AFFineTune',
        Writable  => 'int8u',
        PrintConv => { 0 => 'Off', 1 => 'On' },
    },
    0x307 => {
