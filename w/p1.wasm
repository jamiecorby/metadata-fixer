        },
    },
    0x39c456ac => {
        Name         => 'PictureCtrl',
        SubDirectory => {
            TagTable => 'Image::ExifTool::NikonCapture::PictureCtrl',
        },
    },
    0x3cfc73c6 => {
        Name         => 'RedEyeData',
        SubDirectory => {
            TagTable => 'Image::ExifTool::NikonCapture::RedEyeData',
        },
    },
    0x3d136244 => {
        Name     => 'EditVersionName',
        Writable => 'string',
    },
    0x416391c6 => {
        Name      => 'QuickFix',
        Writable  => 'int8u',
        PrintConv => \%offOn,
    },
    0x56a54260 => {
