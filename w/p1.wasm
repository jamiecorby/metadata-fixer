    0x600 => { Name => 'BlackLevel2',    Writable => 'int16u', Count => 4 },
    0x610 => { Name => 'GainBase',       Writable => 'int16u' },
    0x611 => { Name => 'ValidBits',      Writable => 'int16u', Count => 2 },
