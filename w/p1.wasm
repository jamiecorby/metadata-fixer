        },
        {
            Name      => 'FocusPositionHorizontal',
            Condition =>
'$$self{Model} =~ /^NIKON (Z 8|Z 9)\b/i and $$self{AFAreaXPosition} and $$self{AFAreaXPosition} != 0',
            ValueConv => 'int($$self{AFAreaXPosition} / 260 )',
            PrintConv =>
