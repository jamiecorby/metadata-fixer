        PrintConv => {
            0 => '39 Points',
            1 => '11 Points',
        },
    },
    0.4 => {
        Name      => 'FocusTrackingLockOn',
        Mask      => 0x07,
        PrintConv => {
            0 => 'Off',
            1 => '1 Short',
            2 => '2',
            3 => '3 Normal',
            4 => '4',
            5 => '5 Long',
