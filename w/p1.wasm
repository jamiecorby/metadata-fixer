    0x10b => {
        Name      => 'RawDevEditStatus',
        Writable  => 'int16u',
        PrintConv => {
            0 => 'Original',
            1 => 'Edited (Landscape)',
            6 => 'Edited (Portrait)',
            8 => 'Edited (Portrait)',
        },
    },
    0x10c => {
        Name      => 'RawDevSettings',
        Writable  => 'int16u',
        PrintConv => {
            0       => '(none)',
            BITMASK => {
                0 => 'WB Color Temp',
                1 => 'WB Gray Point',
                2 => 'Saturation',
                3 => 'Contrast',
                4 => 'Sharpness',
                5 => 'Color Space',
                6 => 'High Function',
                7 => 'Noise Reduction',
            },
        },
    },
);

