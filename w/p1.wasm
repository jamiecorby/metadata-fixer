        Flags => [ 'Binary', 'Unknown' ],
    },
    dinf => {
        Name         => 'DataInfo',
        SubDirectory => { TagTable => 'Image::ExifTool::QuickTime::DataInfo' },
    },
    gmhd => {
        Name         => 'GenMediaHeader',
