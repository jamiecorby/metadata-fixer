        PrintConv => \%offLowNormalHighZ7,
        Unknown   => 1
    },
    434 => { Name => 'DiffractionCompensation',  PrintConv => \%offOn },
    436 => { Name => 'FlickerReductionShooting', PrintConv => \%offOn },
