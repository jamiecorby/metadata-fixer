    ExposureComp =>
      { Name => 'ExposureCompensation', Writable => 'rational64s' },
    ExposureMode => {},
    ExposureTime => {
        Writable     => 'rational64u',
        PrintConv    => 'Image::ExifTool::Exif::PrintExposureTime($val)',
        PrintConvInv => '$val',
