        Name    => 'Face31Size',
        Format  => 'int16u[2]',
        RawConv => '$$self{FacesDetected} < 31 ? undef : $val',
    },
    62 => {
        Name    => 'Face32Size',
        Format  => 'int16u[2]',
        RawConv => '$$self{FacesDetected} < 32 ? undef : $val',
    },
);

%Image::ExifTool::Pentax::FilterInfo = (
