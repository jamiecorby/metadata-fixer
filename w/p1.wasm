%Image::ExifTool::Nikon::RotationInfoD500 = (
    %binaryDataAttrs,
    GROUPS => { 0 => 'MakerNotes', 2 => 'Camera' },
    0x1a   => {
        Name      => 'Rotation',
        Mask      => 0x03,
        PrintConv => {
            0 => 'Horizontal',
            1 => 'Rotate 270 CW',
            2 => 'Rotate 90 CW',
            3 => 'Rotate 180',
        },
    },
    0x20 => {
        Name => 'Interval',
        Condition =>
          '$$self{Model} eq "NIKON D5" and $$self{FirmwareVersion} ge "1.40"',
        PrintConv => '$val > 0 ? sprintf("%.0f", $val) : ""',
    },
    0x24 => {
        Name => 'IntervalFrame',
        Condition =>
          '$$self{Model} eq "NIKON D5" and $$self{FirmwareVersion} ge "1.40"',
        PrintConv => '$val > 0 ? sprintf("%.0f", $val) : ""',
    },
    0x0532 => {
        Name      => 'FlickerReductionIndicator',
        Mask      => 0x01,
        PrintConv => { 0 => 'On', 1 => 'Off' },
    },
);

