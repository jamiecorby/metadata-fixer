            ByteOrder => 'Unknown',
        },
    },
    {
        Name         => 'MakerNoteNikon',
        Condition    => '$$valPt=~/^Nikon\x00\x02/',
        SubDirectory => {
            TagTable  => 'Image::ExifTool::Nikon::Main',
