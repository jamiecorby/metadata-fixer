        PrintConv => {
            0 => 'High',
            1 => 'Low',
            2 => 'Off',
        },
    },
    10.2 => {
        Name      => 'ShootingInfoDisplay',
        Mask      => 0x30,
        PrintConv => {
            0 => 'Auto',
            1 => 'Auto',
            2 => 'Manual (dark on light)',
            3 => 'Manual (light on dark)',
        },
    },
    10.3 => {
        Name      => 'LCDIllumination',
        Mask      => 0x08,
        PrintConv => \%offOn,
    },
    10.4 => {
        Name      => 'ExposureDelayMode',
        Mask      => 0x04,
        PrintConv => \%offOn,
    },
    10.5 => {
        Name      => 'GridDisplay',
        Mask      => 0x02,
        PrintConv => \%offOn,
    },
    11.1 => {
        Name      => 'FileNumberSequence',
        Mask      => 0x40,
        PrintConv => \%onOff,
    },
    11.2 => {
        Name         => 'CLModeShootingSpeed',
        Mask         => 0x07,
        PrintConv    => '"$val fps"',
        PrintConvInv => '$val=~s/\s*fps//i; $val',
    },
    12 => {
        Name => 'MaxContinuousRelease',
    },
    13.1 => {
        Name      => 'ScreenTips',
        Mask      => 0x08,
        PrintConv => \%onOff,
    },
    13.2 => {
        Name      => 'BatteryOrder',
        Mask      => 0x04,
        PrintConv => {
            0 => 'MB-D10 First',
            1 => 'Camera Battery First',
        },
    },
    13.3 => {
        Name      => 'MB-D10BatteryType',
        Mask      => 0x03,
        PrintConv => {
            0 => 'LR6 (AA alkaline)',
            1 => 'HR6 (AA Ni-MH)',
            2 => 'FR6 (AA lithium)',
            3 => 'ZR6 (AA Ni-Mn)',
        },
    },
    15.1 => {
        Name      => 'FlashSyncSpeed',
        Mask      => 0xf0,
        PrintConv => {
            0 => '1/320 s (auto FP)',
            1 => '1/250 s (auto FP)',
            2 => '1/250 s',
            3 => '1/200 s',
            4 => '1/160 s',
            5 => '1/125 s',
            6 => '1/100 s',
            7 => '1/80 s',
            8 => '1/60 s',
        },
    },
    15.2 => {
        Name             => 'FlashShutterSpeed',
        Mask             => 0x0f,
        PrintConvColumns => 2,
        PrintConv        => {
            0  => '1/60 s',
            1  => '1/30 s',
            2  => '1/15 s',
            3  => '1/8 s',
            4  => '1/4 s',
            5  => '1/2 s',
            6  => '1 s',
            7  => '2 s',
            8  => '4 s',
            9  => '8 s',
            10 => '15 s',
            11 => '30 s',
        },
    },
    16.1 => {
        Name => 'FlashControlBuilt-in',
        Mask      => 0xc0,
        RawConv   => '$$self{FlashControlBuiltin} = $val',
        PrintConv => {
            0 => 'TTL',
            1 => 'Manual',
            2 => 'Repeating Flash',
            3 => 'Commander Mode',
        },
    },
    16.2 => {
        Name         => 'ManualFlashOutput',
        Condition    => '$$self{FlashControlBuiltin} == 1',
        Mask         => 0x1f,
        ValueConv    => '2 ** (-$val/3)',
        ValueConvInv => '$val > 0 ? -3*log($val)/log(2) : 0',
        PrintConv    => q{
            return 'Full' if $val > 0.99;
            Image::ExifTool::Exif::PrintExposureTime($val);
        },
        PrintConvInv =>
          '$val=~/F/i ? 1 : Image::ExifTool::Exif::ConvertFraction($val)',
    },
    17.1 => {
        Name         => 'RepeatingFlashOutput',
        Condition    => '$$self{FlashControlBuiltin} == 2',
        Mask         => 0x70,
        ValueConv    => '2 ** (-$val-2)',
        ValueConvInv => '$val > 0 ? int(-log($val)/log(2)-2+0.5) : 0',
        PrintConv    => 'Image::ExifTool::Exif::PrintExposureTime($val)',
        PrintConvInv => 'Image::ExifTool::Exif::ConvertFraction($val)',
    },
    17.2 => {
        Name         => 'RepeatingFlashCount',
        Condition    => '$$self{FlashControlBuiltin} == 2',
        Mask         => 0x0f,
        ValueConv    => '$val < 10 ? $val + 1 : 5 * ($val - 7)',
        ValueConvInv => '$val <= 10 ? $val - 1 : $val / 5 + 7',
    },
    18.1 => {
        Name         => 'RepeatingFlashRate',
        Condition    => '$$self{FlashControlBuiltin} == 2',
        Mask         => 0xf0,
        ValueConv    => '$val < 10 ? $val + 1 : 10 * ($val - 8)',
        ValueConvInv => 'int(($val <= 10 ? $val - 1 : $val / 10 + 8) + 0.5)',
        PrintConv    => '"$val Hz"',
        PrintConvInv => '$val=~/(\d+)/; $1 || 0',
    },
    18.2 => {
        Name      => 'CommanderInternalTTLChannel',
        Condition => '$$self{FlashControlBuiltin} == 3',
        Mask      => 0x03,
        PrintConv => {
            0 => '1 ch',
            1 => '2 ch',
            2 => '3 ch',
            3 => '4 ch',
        },
    },
    20.1 => {
        Name         => 'CommanderInternalTTLCompBuiltin',
        Condition    => '$$self{FlashControlBuiltin} == 3',
        Mask         => 0x1f,
        ValueConv    => '($val - 9) / 3',
        ValueConvInv => '$val * 3 + 9',
        PrintConv    => '$val ? sprintf("%+.1f",$val) : 0',
        PrintConvInv => '$val',
    },
    21.1 => {
        Name         => 'CommanderInternalTTLCompGroupA',
        Condition    => '$$self{FlashControlBuiltin} == 3',
        Mask         => 0x1f,
        ValueConv    => '($val - 9) / 3',
        ValueConvInv => '$val * 3 + 9',
        PrintConv    => '$val ? sprintf("%+.1f",$val) : 0',
        PrintConvInv => '$val',
    },
    22.1 => {
        Name         => 'CommanderInternalTTLCompGroupB',
        Condition    => '$$self{FlashControlBuiltin} == 3',
        Mask         => 0x1f,
        ValueConv    => '($val - 9) / 3',
        ValueConvInv => '$val * 3 + 9',
        PrintConv    => '$val ? sprintf("%+.1f",$val) : 0',
        PrintConvInv => '$val',
    },
    26.1 => {
        Name      => 'AutoBracketSet',
        Mask      => 0xc0,
        PrintConv => {
            0 => 'AE & Flash',
            1 => 'AE Only',
            2 => 'Flash Only',
            3 => 'WB Bracketing',
        },
    },
    26.2 => {
