%Image::ExifTool::NikonCustom::SettingsD500 = (
    PROCESS_PROC => \&Image::ExifTool::ProcessBinaryData,
    WRITE_PROC   => \&Image::ExifTool::WriteBinaryData,
    CHECK_PROC   => \&Image::ExifTool::CheckBinaryData,
    WRITABLE     => 1,
    FIRST_ENTRY  => 0,
    GROUPS       => { 0 => 'MakerNotes', 2 => 'Camera' },
    NOTES        => 'Custom settings for the D500.',
    0.1          => {
        Name      => 'CustomSettingsBank',
        Mask      => 0x03,
        PrintConv => {
            0 => 'A',
            1 => 'B',
            2 => 'C',
            3 => 'D',
        },
    },
    1.1 => {
        Name      => 'AF-CPrioritySelection',
        Mask      => 0xc0,
        PrintConv => {
            0 => 'Release',
            1 => 'Release + Focus',
            2 => 'Focus',
            3 => 'Focus + Release',
        },
    },
    1.2 => {
        Name      => 'AF-SPrioritySelection',
        Mask      => 0x20,
        PrintConv => {
            0 => 'Focus',
            1 => 'Release',
        },
    },
    1.3 => {
        Name      => 'NumberOfFocusPoints',
        Mask      => 0x10,
        PrintConv => {
            0 => '55 Points',
            1 => '15 Points',
        },
    },
    1.4 => {
        Name      => 'Three-DTrackingFaceDetection',
        Mask      => 0x08,
        PrintConv => \%offOn,
    },
    1.5 => {
        Name => 'BlockShotAFResponse',
        Mask => 0x07,
    },
    2.1 => {
        Name      => 'FocusPointWrap',
        Mask      => 0x08,
        PrintConv => {
            0 => 'No Wrap',
            1 => 'Wrap',
        },
    },
    2.2 => {
        Name      => 'AFPointBrightness',
        Mask      => 0x06,
        PrintConv => {
            0 => 'Auto',
            1 => 'On',
            2 => 'Off',
        },
    },
    4.1 => {
        Name      => 'ISODisplay',
        Mask      => 0x08,
        PrintConv => {
            0 => 'Show ISO Sensitivity',
            1 => 'Show Frame Count',
        },
    },
    4.2 => {
        Name      => 'GridDisplay',
        Mask      => 0x02,
        PrintConv => \%onOff,
    },
    5.1 => {
        Name      => 'LCDIllumination',
        Mask      => 0x20,
        PrintConv => \%offOn,
    },
    5.2 => {
        Name      => 'ElectronicFront-CurtainShutter',
        Mask      => 0x08,
        PrintConv => \%offOn,
    },
    6.1 => {
        Name      => 'ReverseIndicators',
        Mask      => 0x80,
        PrintConv => {
            0 => '+ 0 -',
            1 => '- 0 +',
        },
    },
    6.2 => {
        Name      => 'CommandDialsReverseRotation',
        Mask      => 0x18,
        PrintConv => {
            0 => 'No',
            1 => 'Shutter Speed & Aperture',
            2 => 'Exposure Compensation',
            3 => 'Exposure Compensation, Shutter Speed & Aperture',
        },
    },
    6.3 => {
        Name      => 'EasyExposureCompensation',
        Mask      => 0x03,
        PrintConv => {
            0 => 'Off',
            1 => 'On',
            2 => 'On (auto reset)',
        },
    },
    7.1 => {
        Name      => 'ExposureControlStepSize',
        Mask      => 0xc0,
        PrintConv => {
            0 => '1/3 EV',
            1 => '1/2 EV',
            2 => '1 EV',
        },
    },
    7.2 => {
        Name      => 'ISOStepSize',
        Mask      => 0x30,
        PrintConv => {
            0 => '1/3 EV',
            1 => '1/2 EV',
            2 => '1 EV',
        },
    },
    7.3 => {
        Name      => 'ExposureCompStepSize',
        Mask      => 0x0c,
        PrintConv => {
            0 => '1/3 EV',
            1 => '1/2 EV',
            2 => '1 EV',
        },
    },
    8.1 => {
        Name      => 'CenterWeightedAreaSize',
        Mask      => 0xe0,
        PrintConv => {
            0 => '6 mm',
            1 => '8 mm',
            2 => '10 mm',
            3 => '13 mm',
            4 => 'Average',
        },
    },
    8.2 => {
        Name         => 'FineTuneOptMatrixMetering',
        Mask         => 0x0f,
        ValueConv    => '($val > 0x7 ? $val - 0x10 : $val) / 6',
        ValueConvInv => 'int($val*6+($val>0?0.5:-0.5))',
        PrintConv    => '$val ? sprintf("%+.2f", $val) : 0',
        PrintConvInv => 'Image::ExifTool::Exif::ConvertFraction($val)',
    },
    9.1 => {
        Name         => 'FineTuneOptCenterWeighted',
        Mask         => 0xf0,
        ValueConv    => '($val > 0x7 ? $val - 0x10 : $val) / 6',
        ValueConvInv => 'int($val*6+($val>0?0.5:-0.5))',
        PrintConv    => '$val ? sprintf("%+.2f", $val) : 0',
