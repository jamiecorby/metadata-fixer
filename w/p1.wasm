        },
    },
    KeywordsHierarchy        => { Name => 'HierarchicalKeywords',  Flat => 1 },
    KeywordsHierarchyKeyword => { Name => 'HierarchicalKeywords1', Flat => 1 },
    KeywordsHierarchyApplied =>
      { Name => 'HierarchicalKeywords1Applied', Flat => 1 },
