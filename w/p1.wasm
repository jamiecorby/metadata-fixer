        },
    },
    4.1 => {
        Name      => 'AELockButton',
        Mask      => 0x0e,
        PrintConv => {
            0 => 'AE/AF Lock',
            1 => 'AE Lock Only',
            2 => 'AF Lock Only',
            3 => 'AE Lock (hold)',
            4 => 'AF-ON',
        },
    },
    4.2 => {
        Name      => 'AELock',
        Mask      => 0x01,
        PrintConv => \%offOn,
    },
    5.1 => {
        Name      => 'ShootingModeSetting',
        Mask      => 0x70,
        PrintConv => {
            0 => 'Single Frame',
            1 => 'Continuous',
            2 => 'Self-timer',
            3 => 'Delayed Remote',
            4 => 'Quick-response Remote',
        },
    },
    5.2 => {
        Name      => 'TimerFunctionButton',
        Mask      => 0x07,
        PrintConv => {
            0 => 'Shooting Mode',
            1 => 'Image Quality/Size',
            2 => 'ISO',
            3 => 'White Balance',
            4 => 'Self-timer',
        },
    },
    6.1 => {
        Name      => 'Metering',
        Mask      => 0x03,
        PrintConv => {
            0 => 'Matrix',
            1 => 'Center-weighted',
            2 => 'Spot',
        },
    },
    8.1 => {
        Name      => 'InternalFlash',
        Mask      => 0x10,
        PrintConv => {
            0 => 'TTL',
            1 => 'Manual',
        },
    },
    8.2 => {
        Name         => 'ManualFlashOutput',
        Mask         => 0x07,
        ValueConv    => '2 ** (-$val)',
        ValueConvInv => '$val > 0 ? -log($val)/log(2) : 0',
        PrintConv    => q{
            return 'Full' if $val > 0.99;
            Image::ExifTool::Exif::PrintExposureTime($val);
        },
        PrintConvInv =>
          '$val=~/F/i ? 1 : Image::ExifTool::Exif::ConvertFraction($val)',
    },
    9 => {
        Name         => 'FlashLevel',
        Format       => 'int8s',
        ValueConv    => '$val / 6',
        ValueConvInv => '$val * 6',
        PrintConv    => 'sprintf("%+.1f",$val)',
        PrintConvInv => '$val',
    },
    10.1 => {
        Name => 'FocusModeSetting',
        Mask      => 0xc0,
        PrintConv => {
            0 => 'Manual',
            1 => 'AF-S',
            2 => 'AF-C',
            3 => 'AF-A',
        },
    },
    11.1 => {
        Name => 'AFAreaModeSetting',
        Mask      => 0x30,
        PrintConv => {
            0 => 'Single Area',
            1 => 'Dynamic Area',
            2 => 'Closest Subject',
        },
    }
);

%Image::ExifTool::NikonCustom::SettingsD90 = (
    PROCESS_PROC => \&Image::ExifTool::ProcessBinaryData,
    WRITE_PROC   => \&Image::ExifTool::WriteBinaryData,
    CHECK_PROC   => \&Image::ExifTool::CheckBinaryData,
    WRITABLE     => 1,
    FIRST_ENTRY  => 0,
    GROUPS       => { 0 => 'MakerNotes', 2 => 'Camera' },
    NOTES        => 'Custom settings for the D90.',
    0.1 => {
        Name      => 'LightSwitch',
        Mask      => 0x08,
        PrintConv => {
            0 => 'LCD Backlight',
            1 => 'LCD Backlight and Shooting Information',
        },
    },
    2.1 => {
        Name      => 'AFAreaModeSetting',
        Mask      => 0x60,
        PrintConv => {
            0 => 'Single Area',
            1 => 'Dynamic Area',
            2 => 'Auto-area',
            3 => '3D-tracking (11 points)',
        },
    },
    2.2 => {
        Name      => 'CenterFocusPoint',
        Mask      => 0x10,
        PrintConv => {
            0 => 'Normal Zone',
            1 => 'Wide Zone',
        },
    },
    2.3 => {
        Name      => 'AFAssist',
        Mask      => 0x01,
        PrintConv => \%onOff,
    },
    2.4 => {
        Name      => 'AFPointIllumination',
        Mask      => 0x06,
        PrintConv => {
            0 => 'Auto',
            1 => 'On',
            2 => 'Off',
        },
    },
    2.5 => {
        Name      => 'FocusPointWrap',
        Mask      => 0x08,
        PrintConv => {
            0 => 'No Wrap',
            1 => 'Wrap',
        },
    },
    3.1 => {
        Name      => 'AELockForMB-D80',
        Mask      => 0x1c,
        PrintConv => {
            0 => 'AE Lock Only',
            1 => 'AF Lock Only',
            2 => 'AE Lock (hold)',
            3 => 'AF-On',
            4 => 'FV Lock',
            5 => 'Focus Point Selection',
            7 => 'AE/AF Lock',
        },
    },
    3.2 => {
        Name      => 'MB-D80BatteryType',
        Mask      => 0x03,
        PrintConv => {
            0 => 'LR6 (AA alkaline)',
            1 => 'HR6 (AA Ni-MH)',
            2 => 'FR6 (AA lithium)',
            3 => 'ZR6 (AA Ni-Mn)',
        },
    },
    4.1 => {
        Name      => 'Beep',
        Mask      => 0x40,
        PrintConv => \%offOn,
    },
    4.2 => {
        Name      => 'GridDisplay',
        Mask      => 0x02,
        PrintConv => \%offOn,
    },
    4.3 => {
        Name      => 'ISODisplay',
        Mask      => 0x0c,
        PrintConv => {
            0 => 'Show ISO/Easy ISO',
            1 => 'Show ISO Sensitivity',
            3 => 'Show Frame Count',
        },
    },
    4.4 => {
        Name      => 'ViewfinderWarning',
        Mask      => 0x01,
        PrintConv => \%onOff,
    },
    4.5 => {
        Name      => 'NoMemoryCard',
        Mask      => 0x20,
        PrintConv => {
            0 => 'Release Locked',
            1 => 'Enable Release',
        },
    },
    5.1 => {
        Name      => 'ScreenTips',
        Mask      => 0x04,
        PrintConv => \%offOn,
    },
    5.2 => {
        Name      => 'FileNumberSequence',
        Mask      => 0x08,
        PrintConv => \%onOff,
    },
    5.3 => {
        Name      => 'ShootingInfoDisplay',
        Mask      => 0xc0,
        PrintConv => {
            0 => 'Auto',
            2 => 'Manual (dark on light)',
            3 => 'Manual (light on dark)',
        },
    },
    5.4 => {
        Name      => 'LCDIllumination',
        Mask      => 0x20,
        PrintConv => \%offOn,
    },
    6.1 => {
        Name      => 'EasyExposureComp',
        Mask      => 0x01,
        PrintConv => \%offOn,
    },
    6.2 => {
        Name      => 'ReverseIndicators',
        Mask      => 0x80,
        PrintConv => {
            0 => '+ 0 -',
            1 => '- 0 +',
        },
    },
    7.1 => {
        Name      => 'ExposureControlStepSize',
        Mask      => 0x40,
        PrintConv => {
            0 => '1/3 EV',
            1 => '1/2 EV',
        },
    },
    8.1 => {
        Name      => 'CenterWeightedAreaSize',
        Mask      => 0x60,
        PrintConv => {
            0 => '6 mm',
            1 => '8 mm',
            2 => '10 mm',
        },
    },
    8.2 => {
        Name         => 'FineTuneOptMatrixMetering',
        Mask         => 0x0f,
        ValueConv    => '($val > 0x7 ? $val - 0x10 : $val) / 6',
        ValueConvInv => 'int($val*6+($val>0?0.5:-0.5))',
        PrintConv    => '$val ? sprintf("%+.2f", $val) : 0',
        PrintConvInv => 'Image::ExifTool::Exif::ConvertFraction($val)',
    },
    9.1 => {
        Name         => 'FineTuneOptCenterWeighted',
        Mask         => 0xf0,
        ValueConv    => '($val > 0x7 ? $val - 0x10 : $val) / 6',
        ValueConvInv => 'int($val*6+($val>0?0.5:-0.5))',
        PrintConv    => '$val ? sprintf("%+.2f", $val) : 0',
        PrintConvInv => 'Image::ExifTool::Exif::ConvertFraction($val)',
    },
    9.2 => {
        Name         => 'FineTuneOptSpotMetering',
        Mask         => 0x0f,
        ValueConv    => '($val > 0x7 ? $val - 0x10 : $val) / 6',
        ValueConvInv => 'int($val*6+($val>0?0.5:-0.5))',
        PrintConv    => '$val ? sprintf("%+.2f", $val) : 0',
        PrintConvInv => 'Image::ExifTool::Exif::ConvertFraction($val)',
    },
    11.1 => {
        Name         => 'CLModeShootingSpeed',
        Mask         => 0x07,
        PrintConv    => '"$val fps"',
        PrintConvInv => '$val=~s/\s*fps//i; $val',
    },
    11.2 => {
        Name      => 'ExposureDelayMode',
        Mask      => 0x40,
        PrintConv => \%offOn,
    },
    13.1 => {
        Name      => 'AutoBracketSet',
        Mask      => 0xe0,
        PrintConv => {
            0 => 'AE & Flash',
            1 => 'AE Only',
            2 => 'Flash Only',
            3 => 'WB Bracketing',
            4 => 'Active D-Lighting',
        },
    },
    13.2 => {
        Name      => 'AutoBracketOrder',
        Mask      => 0x10,
        PrintConv => {
            0 => '0,-,+',
            1 => '-,0,+',
        },
    },
    14.1 => {
        Name      => 'FuncButton',
        Mask      => 0x78,
        PrintConv => {
            1  => 'Framing Grid',
            2  => 'AF-area Mode',
            3  => 'Center Focus Point',
            4  => 'FV Lock',
            5  => 'Flash Off',
            6  => 'Matrix Metering',
            7  => 'Center-weighted Metering',
            8  => 'Spot Metering',
            9  => 'My Menu Top',
            10 => '+ NEF (RAW)',
        },
    },
    16.1 => {
        Name      => 'OKButton',
        Mask      => 0x18,
        PrintConv => {
            1 => 'Select Center Focus Point',
            2 => 'Highlight Active Focus Point',
            3 => 'Not Used',
            0 => 'Not Used',
        },
    },
    17.1 => {
        Name      => 'AELockButton',
        Mask      => 0x38,
        PrintConv => {
            0 => 'AE/AF Lock',
            1 => 'AE Lock Only',
            2 => 'AF Lock Only',
            3 => 'AE Lock (hold)',
            4 => 'AF-ON',
            5 => 'FV Lock',
        },
    },
    18.1 => {
        Name      => 'CommandDialsReverseRotation',
        Mask      => 0x80,
        PrintConv => \%noYes,
    },
    18.2 => {
        Name      => 'ShutterReleaseButtonAE-L',
        Mask      => 0x02,
        PrintConv => \%offOn,
    },
    19.1 => {
        Name             => 'MeteringTime',
        Mask             => 0xf0,
        PrintConvColumns => 2,
        PrintConv        => {
            0 => '4 s',
            1 => '6 s',
            2 => '8 s',
            3 => '16 s',
            4 => '30 s',
            5 => '1 min',
            6 => '5 min',
            7 => '10 min',
            8 => '30 min',
        },
    },
    19.2 => {
        Name      => 'RemoteOnDuration',
        Mask      => 0x03,
        PrintConv => {
            0 => '1 min',
            1 => '5 min',
            2 => '10 min',
            3 => '15 min',
        },
    },
    20.1 => {
        Name      => 'SelfTimerTime',
        Mask      => 0xc0,
        PrintConv => {
            0 => '2 s',
            1 => '5 s',
            2 => '10 s',
            3 => '20 s',
        },
    },
    20.2 => {
        Name => 'SelfTimerShotCount',
        Mask => 0x1e,
    },
    21.1 => {
        Name      => 'PlaybackMonitorOffTime',
        Mask      => 0x1c,
        PrintConv => {
            0 => '4 s',
            1 => '10 s',
            2 => '20 s',
            3 => '1 min',
            4 => '5 min',
            5 => '10 min',
        },
    },
    21.2 => {
        Name      => 'ImageReviewTime',
        Mask      => 0xe0,
        PrintConv => {
            0 => '4 s',
            1 => '10 s',
            2 => '20 s',
            3 => '1 min',
            4 => '5 min',
            5 => '10 min',
        },
    },
    22.1 => {
        Name      => 'MenuMonitorOffTime',
        Mask      => 0xe0,
        PrintConv => {
            0 => '4 s',
            1 => '10 s',
            2 => '20 s',
            3 => '1 min',
            4 => '5 min',
            5 => '10 min',
        },
    },
    22.2 => {
        Name      => 'ShootingInfoMonitorOffTime',
        Mask      => 0x1c,
        PrintConv => {
            0 => '4 s',
            1 => '10 s',
            2 => '20 s',
            3 => '1 min',
            4 => '5 min',
            5 => '10 min',
        },
    },
    23.1 => {
        Name             => 'FlashShutterSpeed',
        Mask             => 0x0f,
        PrintConvColumns => 2,
        PrintConv        => {
            0  => '1/60 s',
            1  => '1/30 s',
            2  => '1/15 s',
            3  => '1/8 s',
            4  => '1/4 s',
            5  => '1/2 s',
            6  => '1 s',
            7  => '2 s',
            8  => '4 s',
            9  => '8 s',
            10 => '15 s',
            11 => '30 s',
        },
    },
    24.1 => {
        Name      => 'InternalFlash',
        Mask      => 0xc0,
        PrintConv => {
            0 => 'TTL',
            1 => 'Manual',
            2 => 'Repeating Flash',
            3 => 'Commander Mode',
        },
    },
    24.2 => {
        Name         => 'ManualFlashOutput',
        Mask         => 0x1f,
        ValueConv    => '2 ** (-$val/3)',
        ValueConvInv => '$val > 0 ? -3*log($val)/log(2) : 0',
        PrintConv    => q{
            return 'Full' if $val > 0.99;
            Image::ExifTool::Exif::PrintExposureTime($val);
        },
        PrintConvInv =>
          '$val=~/F/i ? 1 : Image::ExifTool::Exif::ConvertFraction($val)',
    },
    25.1 => {
        Name         => 'RepeatingFlashOutput',
        Mask         => 0x70,
        ValueConv    => '2 ** (-$val-2)',
        ValueConvInv => '$val > 0 ? int(-log($val)/log(2)-2+0.5) : 0',
        PrintConv    => 'Image::ExifTool::Exif::PrintExposureTime($val)',
        PrintConvInv => 'Image::ExifTool::Exif::ConvertFraction($val)',
    },
    25.2 => {
        Name         => 'RepeatingFlashCount',
        Mask         => 0x0f,
        ValueConv    => '$val < 10 ? $val + 1 : 5 * ($val - 7)',
        ValueConvInv => '$val <= 10 ? $val - 1 : $val / 5 + 7',
    },
    26.1 => {
        Name         => 'RepeatingFlashRate',
        Mask         => 0xf0,
        ValueConv    => '$val < 10 ? $val + 1 : 10 * ($val - 8)',
        ValueConvInv => 'int(($val <= 10 ? $val - 1 : $val / 10 + 8) + 0.5)',
        PrintConv    => '"$val Hz"',
        PrintConvInv => '$val=~/(\d+)/; $1 || 0',
    },
    31.1 => {
        Name      => 'FlashWarning',
        Mask      => 0x80,
        PrintConv => \%onOff,
    },
    31.2 => {
        Name         => 'CommanderInternalTTLComp',
        Mask         => 0x1f,
        ValueConv    => '($val - 9) / 3',
        ValueConvInv => '$val * 3 + 9',
        PrintConv    => '$val ? sprintf("%+.1f",$val) : 0',
        PrintConvInv => '$val',
    },
    31.3 => {
        Name      => 'ModelingFlash',
        Mask      => 0x20,
        PrintConv => \%onOff,
    },
    31.4 => {
        Name      => 'AutoFP',
        Mask      => 0x40,
        PrintConv => \%offOn,
    },
    32.1 => {
        Name         => 'CommanderGroupA_TTLComp',
        Mask         => 0x1f,
        ValueConv    => '($val - 9) / 3',
        ValueConvInv => '$val * 3 + 9',
        PrintConv    => '$val ? sprintf("%+.1f",$val) : 0',
        PrintConvInv => '$val',
    },
    33.1 => {
        Name         => 'CommanderGroupB_TTLComp',
        Mask         => 0x1f,
        ValueConv    => '($val - 9) / 3',
        ValueConvInv => '$val * 3 + 9',
        PrintConv    => '$val ? sprintf("%+.1f",$val) : 0',
        PrintConvInv => '$val',
    },
    34.1 => {
        Name      => 'LiveViewAF',
        Mask      => 0xc0,
        PrintConv => {
            0 => 'Face Priority',
            1 => 'Wide Area',
            2 => 'Normal Area',
        },
    },
);

%Image::ExifTool::NikonCustom::SettingsD3 = (
    PROCESS_PROC => \&Image::ExifTool::ProcessBinaryData,
    WRITE_PROC   => \&Image::ExifTool::WriteBinaryData,
    CHECK_PROC   => \&Image::ExifTool::CheckBinaryData,
    WRITABLE     => 1,
    FIRST_ENTRY  => 0,
    GROUPS       => { 0 => 'MakerNotes', 2 => 'Camera' },
    NOTES        => 'Custom settings for the D3, D3S, D3X, D300 and D300S.',
    0.1 => {
        Name      => 'CustomSettingsBank',
        Mask      => 0x03,
        PrintConv => {
            0 => 'A',
            1 => 'B',
            2 => 'C',
            3 => 'D',
        },
    },
    0.2 => {
        Name  => 'CustomSettingsAllDefault',
        Notes =>
'"No" if any custom setting for this bank was changed from the default',
        Mask      => 0x80,
        PrintConv => { 0 => 'Yes', 1 => 'No' },
    },
    1.1 => {
        Name      => 'AF-CPrioritySelection',
        Mask      => 0xc0,
        PrintConv => {
            0 => 'Release',
            1 => 'Release + Focus',
            2 => 'Focus',
        },
    },
    1.2 => {
        Name      => 'AF-SPrioritySelection',
        Mask      => 0x20,
        PrintConv => {
            0 => 'Focus',
            1 => 'Release',
        },
    },
    1.3 => {
        Name      => 'AFPointSelection',
        Mask      => 0x10,
        PrintConv => {
            0 => '51 Points',
            1 => '11 Points',
        },
    },
    1.4 => {
        Name      => 'DynamicAFArea',
        Mask      => 0x0c,
        PrintConv => {
            0 => '9 Points',
            1 => '21 Points',
            2 => '51 Points',
            3 => '51 Points (3D-tracking)',
        },
    },
    1.5 => {
        Name      => 'FocusTrackingLockOn',
        Condition => '$$self{Model} !~ /D3S\b/',
        Notes     => 'not D3S',
        Mask      => 0x03,
        PrintConv => {
            0 => 'Long',
            1 => 'Normal',
            2 => 'Short',
            3 => 'Off',
        },
    },
    2.1 => {
        Name      => 'AFActivation',
        Mask      => 0x80,
        PrintConv => {
            0 => 'Shutter/AF-On',
            1 => 'AF-On Only',
        },
    },
    2.2 => {
        Name      => 'FocusPointWrap',
        Mask      => 0x08,
        PrintConv => {
            0 => 'No Wrap',
            1 => 'Wrap',
        },
    },
    2.3 => [
        {
            Name      => 'AFPointIllumination',
            Condition => '$$self{Model} =~ /D3[SX]?\b/',
            Notes     => 'D3',
            Mask      => 0x60,
            PrintConv => {
                0 => 'On in Continuous Shooting and Manual Focusing',
                1 => 'On During Manual Focusing',
                2 => 'On in Continuous Shooting Modes',
                3 => 'Off',
            },
        },
        {
            Name      => 'AFPointIllumination',
            Notes     => 'D300',
            Mask      => 0x06,
            PrintConv => {
                0 => 'Auto',
                1 => 'Off',
                2 => 'On',
            },
        },
    ],
    2.4 => {
        Name      => 'AFPointBrightness',
        Condition => '$$self{Model} =~ /D3[SX]?\b/',
        Notes     => 'D3 only',
        Mask      => 0x06,
        PrintConv => {
            0 => 'Low',
            1 => 'Normal',
            2 => 'High',
            3 => 'Extra High',
        },
    },
    2.5 => {
        Name      => 'AFAssist',
        Condition => '$$self{Model} =~ /D300S?\b/',
        Notes     => 'D300 only',
        Mask      => 0x01,
        PrintConv => \%onOff,
    },
    3.1 => {
        Name      => 'AFOnButton',
        Condition => '$$self{Model} =~ /D3[SX]?\b/',
        Notes     => 'D3 only',
        Mask      => 0x07,
        PrintConv => {
            0 => 'AF On',
            1 => 'AE/AF Lock',
            2 => 'AE Lock Only',
            3 => 'AE Lock (reset on release)',
            4 => 'AE Lock (hold)',
            5 => 'AF Lock Only',
        },
    },
    3.2 => {
        Name      => 'VerticalAFOnButton',
        Condition => '$$self{Model} =~ /D3[SX]?\b/',
        Notes     => 'D3 only',
        Mask      => 0x70,
        PrintConv => {
            0 => 'AF On',
            1 => 'AE/AF Lock',
            2 => 'AE Lock Only',
            3 => 'AE Lock (reset on release)',
            4 => 'AE Lock (hold)',
            5 => 'AF Lock Only',
            7 => 'Same as AF On',
        },
    },
    3.3 => {
        Name      => 'AF-OnForMB-D10',
        Condition => '$$self{Model} =~ /D300S?\b/',
        Notes     => 'D300 only',
        Mask      => 0x70,
        PrintConv => {
            0 => 'AF-On',
            1 => 'AE/AF Lock',
            2 => 'AE Lock Only',
            3 => 'AE Lock (reset on release)',
            4 => 'AE Lock (hold)',
            5 => 'AF Lock Only',
            6 => 'Same as FUNC Button',
        },
    },
    4.1 => {
        Name      => 'FocusTrackingLockOn',
        Condition => '$$self{Model} =~ /D3S\b/',
        Notes     => 'D3S only',
        Mask      => 0x07,
        PrintConv => {
            0 => '5 (Long)',
            1 => '4',
            2 => '3 (Normal)',
            3 => '2',
            4 => '1 (Short)',
            5 => 'Off',
        },
    },
    4.2 => {
        Name      => 'AssignBktButton',
        Condition => '$$self{Model} =~ /D3S\b/',
        Notes     => 'D3S only',
        Mask      => 0x08,
        PrintConv => {
            0 => 'Auto Bracketing',
            1 => 'Multiple Exposure',
        },
    },
    4.3 => {
        Name      => 'MultiSelectorLiveView',
        Condition => '$$self{Model} =~ /D3S\b/',
        Notes     => 'D3S only',
        Mask      => 0xc0,
        PrintConv => {
            0 => 'Reset',
            1 => 'Zoom On/Off',
            2 => 'Start Movie Recording',
            3 => 'Not Used',
        },
    },
    4.4 => {
        Name      => 'InitialZoomLiveView',
        Condition => '$$self{Model} =~ /D3S\b/',
        Notes     => 'D3S only',
        Mask      => 0x30,
        PrintConv => {
            0 => 'Low Magnification',
            1 => 'Medium Magnification',
            2 => 'High Magnification',
        },
    },
    6.1 => {
        Name      => 'ISOStepSize',
        Mask      => 0xc0,
        PrintConv => {
            0 => '1/3 EV',
            1 => '1/2 EV',
            2 => '1 EV',
        },
    },
    6.2 => {
        Name      => 'ExposureControlStepSize',
        Mask      => 0x30,
        PrintConv => {
            0 => '1/3 EV',
            1 => '1/2 EV',
            2 => '1 EV',
        },
    },
    6.3 => {
        Name      => 'ExposureCompStepSize',
        Mask      => 0x0c,
        PrintConv => {
            0 => '1/3 EV',
            1 => '1/2 EV',
            2 => '1 EV',
        },
    },
    6.4 => {
        Name      => 'EasyExposureCompensation',
        Mask      => 0x03,
        PrintConv => {
            0 => 'Off',
            1 => 'On',
            2 => 'On (auto reset)',
        },
    },
    7.1 => [
        {
            Name      => 'CenterWeightedAreaSize',
            Condition => '$$self{Model} =~ /D3[SX]?\b/',
            Notes     => 'D3',
            Mask      => 0xe0,
            PrintConv => {
                0 => '8 mm',
                1 => '12 mm',
                2 => '15 mm',
                3 => '20 mm',
                4 => 'Average',
            },
        },
        {
            Name      => 'CenterWeightedAreaSize',
            Notes     => 'D300',
            Mask      => 0xe0,
            PrintConv => {
                0 => '6 mm',
                1 => '8 mm',
                2 => '10 mm',
                3 => '13 mm',
                4 => 'Average',
            },
        },
    ],
    7.2 => {
        Name         => 'FineTuneOptCenterWeighted',
        Mask         => 0x0f,
        ValueConv    => '($val > 0x7 ? $val - 0x10 : $val) / 6',
        ValueConvInv => 'int($val*6+($val>0?0.5:-0.5))',
        PrintConv    => '$val ? sprintf("%+.2f", $val) : 0',
        PrintConvInv => 'Image::ExifTool::Exif::ConvertFraction($val)',
    },
    8.1 => {
        Name         => 'FineTuneOptMatrixMetering',
        Mask         => 0xf0,
        ValueConv    => '($val > 0x7 ? $val - 0x10 : $val) / 6',
        ValueConvInv => 'int($val*6+($val>0?0.5:-0.5))',
        PrintConv    => '$val ? sprintf("%+.2f", $val) : 0',
        PrintConvInv => 'Image::ExifTool::Exif::ConvertFraction($val)',
    },
    8.2 => {
        Name         => 'FineTuneOptSpotMetering',
