    },
    0xbb => {
        Name      => 'VideoBurstMode',
        Writable  => 'int32u',
        PrintHex  => 1,
        PrintConv => {
            0x01   => 'Off',
            0x04   => 'Post Focus',
            0x18   => '4K Burst',
            0x28   => '4K Burst (Start/Stop)',
            0x48   => '4K Pre-burst',
            0x108  => 'Loop Recording',
            0x810  => '6K Burst',
            0x820  => '6K Burst (Start/Stop)',
