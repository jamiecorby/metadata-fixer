    },
    pmax => { Name => 'LargestPacketSize', Format => 'int32u' },
    dmax => {
        Name      => 'LargestPacketDuration',
        Format    => 'int32u',
        PrintConv => 'sprintf("%.3f s",$val/1000)',
    },
