%Image::ExifTool::NikonCustom::SettingsD80 = (
    PROCESS_PROC => \&Image::ExifTool::ProcessBinaryData,
    WRITE_PROC   => \&Image::ExifTool::WriteBinaryData,
    CHECK_PROC   => \&Image::ExifTool::CheckBinaryData,
    WRITABLE     => 1,
    FIRST_ENTRY  => 0,
    GROUPS       => { 0 => 'MakerNotes', 2 => 'Camera' },
    NOTES        => 'Custom settings for the Nikon D80.',
    0.1          => {
        Name      => 'Beep',
        Mask      => 0x80,
        PrintConv => \%onOff,
    },
    0.2 => {
        Name      => 'AFAssist',
        Mask      => 0x40,
        PrintConv => \%onOff,
    },
    0.3 => {
        Name      => 'NoMemoryCard',
        Mask      => 0x20,
        PrintConv => {
            0 => 'Release Locked',
            1 => 'Enable Release',
        },
    },
    0.4 => {
        Name      => 'ImageReview',
        Mask      => 0x10,
        PrintConv => \%onOff,
    },
    0.5 => {
        Name      => 'Illumination',
        Mask      => 0x08,
        PrintConv => \%offOn,
    },
    0.6 => {
        Name      => 'MainDialExposureComp',
        Mask      => 0x04,
        PrintConv => \%offOn,
    },
    0.7 => {
        Name      => 'EVStepSize',
        Mask      => 0x01,
        PrintConv => {
            0 => '1/3 EV',
            1 => '1/2 EV',
        },
    },
    1.1 => {
        Name      => 'AutoISO',
        Mask      => 0x40,
        PrintConv => \%offOn,
    },
    1.2 => {
        Name      => 'AutoISOMax',
        Mask      => 0x30,
        PrintConv => {
            0 => 200,
            1 => 400,
            2 => 800,
            3 => 1600,
        },
    },
    1.3 => {
        Name             => 'AutoISOMinShutterSpeed',
        Mask             => 0x0f,
        PrintConvColumns => 2,
        PrintConv        => {
            0  => '1/125 s',
            1  => '1/100 s',
            2  => '1/80 s',
            3  => '1/60 s',
            4  => '1/40 s',
            5  => '1/30 s',
            6  => '1/15 s',
            7  => '1/8 s',
            8  => '1/4 s',
            9  => '1/2 s',
            10 => '1 s',
        },
    },
    2.1 => {
        Name      => 'AutoBracketSet',
        Mask      => 0xc0,
        PrintConv => {
            0 => 'AE & Flash',
            1 => 'AE Only',
            2 => 'Flash Only',
            3 => 'WB Bracketing',
        },
    },
    2.2 => {
        Name      => 'AutoBracketOrder',
        Mask      => 0x20,
        PrintConv => {
            0 => '0,-,+',
            1 => '-,0,+',
        },
    },
    3.1 => {
        Name      => 'MonitorOffTime',
        Mask      => 0xe0,
        PrintConv => {
            0 => '5 s',
            1 => '10 s',
            2 => '20 s',
            3 => '1 min',
            4 => '5 min',
            5 => '10 min',
        },
    },
    3.2 => {
        Name      => 'MeteringTime',
        Mask      => 0x1c,
        PrintConv => {
            0 => '4 s',
            1 => '6 s',
            2 => '8 s',
            3 => '16 s',
            4 => '30 s',
            5 => '30 min',
        },
    },
    3.3 => {
        Name      => 'SelfTimerTime',
        Mask      => 0x03,
        PrintConv => {
            0 => '2 s',
            1 => '5 s',
            2 => '10 s',
            3 => '20 s',
        },
    },
    4.1 => {
        Name      => 'AELockButton',
        Mask      => 0x1e,
        PrintConv => {
            0  => 'AE/AF Lock',
            1  => 'AE Lock Only',
            2  => 'AF Lock Only',
            3  => 'AE Lock (hold)',
            4  => 'AF-ON',
            5  => 'FV Lock',
            6  => 'Focus Area Selection',
            7  => 'AE-L/AF-L/AF Area',
            8  => 'AE-L/AF Area',
            9  => 'AF-L/AF Area',
            10 => 'AF-ON/AF Area',
        },
    },
    4.2 => {
        Name      => 'AELock',
        Mask      => 0x01,
        PrintConv => \%offOn,
    },
    4.3 => {
        Name      => 'RemoteOnDuration',
        Mask      => 0xc0,
        PrintConv => {
            0 => '1 min',
            1 => '5 min',
            2 => '10 min',
            3 => '15 min',
        },
    },
    5.1 => {
        Name      => 'CommandDials',
        Mask      => 0x80,
        PrintConv => {
            0 => 'Standard (Main Shutter, Sub Aperture)',
            1 => 'Reversed (Main Aperture, Sub Shutter)',
        },
    },
    5.2 => {
        Name      => 'FunctionButton',
        Mask      => 0x78,
        PrintConv => {
            0 => 'ISO Display',
            1 => 'Framing Grid',
            2 => 'AF-area Mode',
            3 => 'Center AF Area',
            4 => 'FV Lock',
            5 => 'Flash Off',
            6 => 'Matrix Metering',
            7 => 'Center-weighted',
            8 => 'Spot Metering',
        },
    },
    6.1 => {
        Name      => 'GridDisplay',
        Mask      => 0x80,
        PrintConv => \%offOn,
    },
    6.2 => {
        Name      => 'ViewfinderWarning',
        Mask      => 0x40,
        PrintConv => \%onOff,
    },
    6.3 => {
        Name      => 'CenterWeightedAreaSize',
        Mask      => 0x0c,
        PrintConv => {
            0 => '6 mm',
            1 => '8 mm',
            2 => '10 mm',
        },
    },
    6.4 => {
        Name      => 'ExposureDelayMode',
        Mask      => 0x20,
        PrintConv => \%offOn,
    },
    6.5 => {
        Name      => 'MB-D80Batteries',
        Mask      => 0x03,
        PrintConv => {
            0 => 'LR6 (AA Alkaline)',
            1 => 'HR6 (AA Ni-MH)',
            2 => 'FR6 (AA Lithium)',
            3 => 'ZR6 (AA Ni-Mg)',
        },
    },
    7.1 => {
        Name      => 'FlashWarning',
        Mask      => 0x80,
        PrintConv => \%onOff,
    },
    7.2 => {
        Name         => 'FlashShutterSpeed',
        Mask         => 0x78,
        ValueConv    => '2 ** ($val - 6)',
        ValueConvInv => '$val>0 ? int(log($val)/log(2)+6+0.5) : 0',
        PrintConv    => 'Image::ExifTool::Exif::PrintExposureTime($val)',
        PrintConvInv => 'Image::ExifTool::Exif::ConvertFraction($val)',
    },
    7.3 => {
        Name      => 'AutoFP',
        Mask      => 0x04,
        PrintConv => \%offOn,
    },
    7.4 => {
        Name      => 'ModelingFlash',
        Mask      => 0x02,
        PrintConv => \%offOn,
    },
    8.1 => {
        Name      => 'InternalFlash',
        Mask      => 0xc0,
        PrintConv => {
            0 => 'TTL',
            1 => 'Manual',
            2 => 'Repeating Flash',
            3 => 'Commander Mode',
        },
    },
    8.2 => {
        Name         => 'ManualFlashOutput',
        Mask         => 0x07,
        ValueConv    => '2 ** (-$val)',
        ValueConvInv => '$val > 0 ? -log($val)/log(2) : 0',
        PrintConv    => q{
            return 'Full' if $val > 0.99;
            Image::ExifTool::Exif::PrintExposureTime($val);
        },
        PrintConvInv =>
          '$val=~/F/i ? 1 : Image::ExifTool::Exif::ConvertFraction($val)',
    },
    9.1 => {
        Name         => 'RepeatingFlashOutput',
        Mask         => 0x70,
        ValueConv    => '2 ** (-$val-2)',
        ValueConvInv => '$val > 0 ? int(-log($val)/log(2)-2+0.5) : 0',
        PrintConv    => 'Image::ExifTool::Exif::PrintExposureTime($val)',
        PrintConvInv => 'Image::ExifTool::Exif::ConvertFraction($val)',
    },
    9.2 => {
        Name         => 'RepeatingFlashCount',
        Mask         => 0x0f,
        ValueConv    => '$val < 10 ? $val + 1 : 5 * ($val - 7)',
        ValueConvInv => '$val <= 10 ? $val - 1 : $val / 5 + 7',
    },
    10.1 => {
        Name         => 'RepeatingFlashRate',
        Mask         => 0xf0,
        ValueConv    => '$val < 10 ? $val + 1 : 10 * ($val - 8)',
        ValueConvInv => 'int(($val <= 10 ? $val - 1 : $val / 10 + 8) + 0.5)',
        PrintConv    => '"$val Hz"',
        PrintConvInv => '$val=~/(\d+)/; $1 || 0',
    },
    10.2 => {
        Name         => 'CommanderChannel',
        Mask         => 0x03,
        ValueConv    => '$val + 1',
        ValueConvInv => '$val - 1',
    },
    11.1 => {
        Name      => 'CommanderInternalFlash',
        Mask      => 0xc0,
        PrintConv => {
            0 => 'TTL',
            1 => 'Manual',
            2 => 'Off',
        },
    },
    11.2 => {
        Name      => 'CommanderGroupAMode',
        Mask      => 0x30,
        PrintConv => {
            0 => 'TTL',
            1 => 'Auto Aperture',
            2 => 'Manual',
            3 => 'Off',
        },
    },
    11.3 => {
        Name      => 'CommanderGroupBMode',
        Mask      => 0x0c,
        PrintConv => {
            0 => 'TTL',
            1 => 'Auto Aperture',
            2 => 'Manual',
            3 => 'Off',
        },
    },
    12.1 => {
        Name         => 'CommanderInternalTTLComp',
        Mask         => 0x1f,
        ValueConv    => '($val - 9) / 3',
        ValueConvInv => '$val * 3 + 9',
        PrintConv    => '$val ? sprintf("%+.1f",$val) : 0',
        PrintConvInv => '$val',
    },
    12.2 => {
        Name         => 'CommanderInternalManualOutput',
        Mask         => 0xe0,
        ValueConv    => '2 ** (-$val)',
        ValueConvInv => '$val > 0 ? int(-log($val)/log(2)+0.5) : 0',
        PrintConv    => q{
            return 'Full' if $val > 0.99;
            Image::ExifTool::Exif::PrintExposureTime($val);
        },
        PrintConvInv =>
          '$val=~/F/i ? 1 : Image::ExifTool::Exif::ConvertFraction($val)',
    },
    13.1 => {
        Name         => 'CommanderGroupA_TTL-AAComp',
        Mask         => 0x1f,
        ValueConv    => '($val - 9) / 3',
        ValueConvInv => '$val * 3 + 9',
        PrintConv    => '$val ? sprintf("%+.1f",$val) : 0',
        PrintConvInv => '$val',
    },
    13.2 => {
        Name         => 'CommanderGroupAManualOutput',
        Mask         => 0xe0,
        ValueConv    => '2 ** (-$val)',
        ValueConvInv => '$val > 0 ? int(-log($val)/log(2)+0.5) : 0',
        PrintConv    => q{
            return 'Full' if $val > 0.99;
            Image::ExifTool::Exif::PrintExposureTime($val);
        },
        PrintConvInv =>
          '$val=~/F/i ? 1 : Image::ExifTool::Exif::ConvertFraction($val)',
    },
    14.1 => {
        Name         => 'CommanderGroupB_TTL-AAComp',
        Mask         => 0x1f,
        ValueConv    => '($val - 9) / 3',
        ValueConvInv => '$val * 3 + 9',
        PrintConv    => '$val ? sprintf("%+.1f",$val) : 0',
        PrintConvInv => '$val',
    },
    14.2 => {
        Name         => 'CommanderGroupBManualOutput',
        Mask         => 0xe0,
        ValueConv    => '2 ** (-$val)',
        ValueConvInv => '$val > 0 ? int(-log($val)/log(2)+0.5) : 0',
        PrintConv    => q{
            return 'Full' if $val > 0.99;
            Image::ExifTool::Exif::PrintExposureTime($val);
        },
        PrintConvInv =>
          '$val=~/F/i ? 1 : Image::ExifTool::Exif::ConvertFraction($val)',
    },
    15.1 => {
        Name      => 'CenterAFArea',
        Mask      => 0x80,
        PrintConv => {
            0 => 'Normal Zone',
            1 => 'Wide Zone',
        },
    },
    15.2 => {
        Name      => 'FocusAreaSelection',
        Mask      => 0x04,
        PrintConv => {
            0 => 'No Wrap',
            1 => 'Wrap',
        },
    },
    15.3 => {
        Name      => 'AFAreaIllumination',
        Mask      => 0x03,
        PrintConv => {
            0 => 'Auto',
            1 => 'Off',
            2 => 'On',
        },
    },
    16.1 => {
        Name      => 'AFAreaModeSetting',
        Mask      => 0xc0,
        PrintConv => {
            0 => 'Single Area',
            1 => 'Dynamic Area',
            2 => 'Auto-area',
        },
    },
);

%Image::ExifTool::NikonCustom::SettingsD40 = (
