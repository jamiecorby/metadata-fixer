%Image::ExifTool::EXE::AR = (
    PROCESS_PROC => \&Image::ExifTool::ProcessBinaryData,
    GROUPS       => { 2 => 'Other' },
    NOTES        => q{
        Information extracted from static libraries.
    },
    16 => {
        Name      => 'CreateDate',
