    0x10c => { Name => 'WB_RBLevels6600K', Writable => 'int16u', Count => -1 },
    0x10d => { Name => 'WB_RBLevels7500K', Writable => 'int16u', Count => -1 },
    0x10e => { Name => 'WB_RBLevelsCWB1',  Writable => 'int16u', Count => -1 },
