my %mediaMatrix = (
    Notes => q{
        The lookup below is used to add human-readable descriptions to Media Matrix
        ID's in PLUS Media Summary Codes.
    },
    OTHER => sub {
        my ( $val, $inv, $conv ) = @_;
        $val = uc $val;
        if ($inv) {
            $val =~ s/\(.*?\)//sg;
            $val =~ s/^\s*?PLUS\s+(V[0-9]+)\s+(U[0-9]+)\s*;/|PLUS|$1|$2|/s;
            $val =~ tr/;/|/;
            $val =~ tr/0-9A-Z|//dc;
            $val .= '|' unless $val =~ /\|$/;
            ValidateMediaSummary($val) or return undef;
        }
        elsif ( $val =~ /^\|PLUS\|(.*?)\|(.*?)\|(.*)/s ) {
            my ( $ver, $num, $code ) = ( $1, $2, $3 );
            $ver .= " (LDF Version $1.$2)" if $ver =~ /V0*(\d+)(\d{2})$/;
            $num .= " ($1 Media Usages:)"  if $num =~ /U0*(\d+)/;
            $code =~ tr/0-9A-Z|//dc;
            $val = "PLUS $ver $num";
            while ( $code =~ /(\d[A-Z]{3})/g ) {
                my $mmid = $1;
                if ( defined $$conv{$mmid} ) {
                    $val .= " $mmid ($$conv{$mmid})";
                }
                elsif ( $mmid =~ /^1I([A-Z])([A-Z])/ ) {
                    my $n = ( ord($1) - 65 ) * 26 + ord($2) - 65 + 1;
                    $val .= "; $mmid ($n Usage Items:)";
                }
                elsif ( $mmid =~ /^1UN([A-Z])/ ) {
                    $val .= " (Usage Number $1)";
                }
                else {
                    $val .= " $mmid";
                }
            }
        }
        return $val;
    },
    '1IAA' => '1 Usage Item:',
    '1IAB' => '2 Usage Items:',
    '1IAC' => '3 Usage Items:',
    '1IAD' => '4 Usage Items:',
    '1IAE' => '5 Usage Items:',
    '1UNA' => 'Usage Number A',
