        },
    },
    0xb6 => {
        Name      => 'GPSLongitude',
        Format    => 'rational32u',
        Groups    => { 1 => 'GPS', 2 => 'Location' },
        Combine   => 2,
        Notes     => 'combined with tags 0xb7 and 0xb8',
        ValueConv => 'Image::ExifTool::GPS::ToDegrees($val)',
