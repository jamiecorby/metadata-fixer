);

%Image::ExifTool::Sanyo::Thumbnail = (
    PROCESS_PROC => \&Image::ExifTool::ProcessBinaryData,
    GROUPS       => { 0 => 'MakerNotes', 2 => 'Camera' },
    FIRST_ENTRY  => 0,
    FORMAT       => 'int32u',
    1            => 'ThumbnailWidth',
    2            => 'ThumbnailHeight',
    3            => 'ThumbnailLength',
    4            => { Name => 'ThumbnailOffset', IsOffset => 1 },
);

sub FixOffsets($$$$;$) {
    my ( $valuePtr, $valEnd, $size, $tagID, $wFlag ) = @_;
    if ( $tagID == 0x100 ) {
        $_[0] = undef if $wFlag;
    }
    else {
        $_[0] = $valEnd;
        ++$size if $size & 0x01;
        $_[1] += $size;
    }
}

1;

__END__


package Image::ExifTool::Scalado;

use strict;
use vars            qw($VERSION);
use Image::ExifTool qw(:DataAccess :Utils);
use Image::ExifTool::PLIST;

$VERSION = '1.01';

sub ProcessScalado($$$);

%Image::ExifTool::Scalado::Main = (
    GROUPS       => { 0 => 'APP4', 1 => 'Scalado', 2 => 'Image' },
    PROCESS_PROC => \&ProcessScalado,
    TAG_PREFIX   => 'Scalado',
    FORMAT       => 'int32s',
    NOTES        => q{
        Tags extracted from the JPEG APP4 "SCALADO" segment found in images from
        HTC, LG and Samsung phones.  (Presumably written by Scalado mobile software,
        L<http://www.scalado.com/>.)
    },
    SPMO => {
        Name    => 'DataLength',
        Unknown => 1,
    },
    WDTH => {
        Name      => 'PreviewImageWidth',
        ValueConv => '$val ? abs($val) : undef',
    },
    HGHT => {
        Name      => 'PreviewImageHeight',
        ValueConv => '$val ? abs($val) : undef',
    },
    QUAL => {
        Name      => 'PreviewQuality',
        ValueConv => '$val ? abs($val) : undef',
    },
);

sub ProcessScalado($$$) {
    my ( $et, $dirInfo, $tagTablePtr ) = @_;
    my $dataPt  = $$dirInfo{DataPt};
    my $pos     = 0;
    my $end     = length $$dataPt;
    my $unknown = $et->Options('Unknown');

    $et->VerboseDir( 'APP4 SCALADO', undef, $end );
    SetByteOrder('MM');

    for ( ; ; ) {
        last if $pos + 12 > $end;
        my $tag = substr( $$dataPt, $pos, 4 );
        my $ver = Get32u( $dataPt, $pos + 4 );
        if ( not $$tagTablePtr{$tag} and $unknown ) {
            my $name = $tag;
            $name =~ tr/-A-Za-z0-9_//dc;
            last unless length $name;
            AddTagToTable(
                $tagTablePtr,
                $tag,
                {
                    Name        => "Scalado_$name",
                    Description => "Scalado $name",
                    Unknown     => 1,
                }
            );
        }
        $et->HandleTag(
            $tagTablePtr, $tag, undef,
            DataPt => $dataPt,
            Start  => $pos + 8,
            Size   => 4,
            Extra  => ", ver $ver",
        );
        if ( $tag eq 'SPMO' ) {
            my $val = Get32u( $dataPt, $pos + 8 );
            if ( $ver < 5 ) {
                $end -= $val;
            }
            else {
                $end = $val + 12;
            }
        }
        $pos += 12;
    }
    return 1;
}

1;

__END__


package Image::ExifTool;

use strict;

sub ShiftTime($;$$$);

sub ApplyShift($$$$;$) {
    my ( $self, $func, $shift, $val, $nvHash ) = @_;

    my $pre     = ( $shift =~ s/^(\+|-)// ) ? $1 : '+';
    my $dir     = ( $pre eq '+' )           ? 1  : -1;
    my $tagInfo = $$nvHash{TagInfo};
    my $tag     = $$tagInfo{Name};
    my $shiftOffset;
    if ( $$nvHash{ShiftOffset} ) {
        $shiftOffset = $$nvHash{ShiftOffset};
    }
    else {
        $shiftOffset = $$nvHash{ShiftOffset} = {};
    }

    local $SIG{'__WARN__'} = \&SetWarning;
    SetWarning(undef);

    my ( $type, $err );
    foreach $type ( 'ValueConv', 'Shift', 'ValueConvInv' ) {
        if ( $type eq 'Shift' ) {
            $err = eval "Shift$func(\$val, \$shift, \$dir, \$shiftOffset)";
        }
        elsif ( $$tagInfo{$type} ) {
            my $conv = $$tagInfo{$type};
            if ( ref $conv eq 'CODE' ) {
                $val = &$conv( $val, $self );
            }
            else {
                return "Can't handle $type for $tag in ApplyShift()"
                  if ref $$tagInfo{$type};
                $val = eval $$tagInfo{$type};
            }
        }
        else {
            next;
        }
        $err         and return $err;
        $@           and SetWarning($@);
        GetWarning() and return CleanWarning();
    }
    $nvHash->{Value} = [$val];
    return undef;
}

sub CheckShift($$) {
    my ( $type, $shift ) = @_;
    my $err;
    if ( $type eq 'Time' ) {
        return "No shift direction" unless $shift =~ s/^(\+|-)//;
        my $testTime = '2005:11:02 09:00:13.25-04:00';
        $err = ShiftTime( $testTime, $shift, $1 eq '+' ? 1 : -1 );
    }
    else {
        $err = "Unknown shift type ($type)";
    }
    return $err;
}

sub DaysInMonth($$) {
    my ( $mon, $year ) = @_;
    my @days = ( 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 );
    while ( $mon < 1 )  { $mon += 12; --$year; }
    while ( $mon > 12 ) { $mon -= 12; ++$year; }
    return $days[ $mon - 1 ] unless $mon == 2 and not $year % 4;
    return 29 if $year % 100 or not $year % 400;
    return 28;
}

sub SplitTime($$;$) {
    my ( $val, $vals, $time ) = @_;
    if ($time) {
        $val =~ s/(^|[-+:\s]):/${1}0:/g;
        $val =~ s/:([:\s]|$)/:0$1/g;
    }
    if ( $val =~ s/^(\d{4})-(\d{2})-(\d{2})/$1:$2:$3/ ) {
        $val =~ tr/T/ /;
    }
    $val =~ s/(\+|-)/ $1/;
    my @words = split ' ', $val;
    my $err   = 1;
    my @v;
    for ( ; ; ) {
        my $word = shift @words;
        last unless defined $word;
        my @vals = $word =~ /(?=\d|\.\d)\d*(?:\.\d*)?/g or last;
        if ( $word =~ /^(\+|-)/ ) {
            ( defined $v[6] or @vals > 2 ) and $err = 1, last;
            my $sign = ( $1 ne '-' ) ? 1 : -1;
            $v[6] = $sign * shift(@vals);
            $v[7] = $sign * ( shift(@vals) || 0 );
        }
        elsif (( @words and $words[0] =~ /^\d+/ )
            or ( not $time and $vals[0] =~ /^\d{3}/ )
            or ( $time and not defined $$time[3] and not defined $v[0] ) )
        {
            ( @v or @vals > 3 ) and $err = 1, last;
            not $time and @vals != 3 and $err = 1, last;
            $v[2] = pop(@vals);
            $v[1] = pop(@vals) || 0;
            $v[0] = pop(@vals) || 0;
        }
        else {
            ( defined $v[3] or defined $v[6] or @vals > 3 ) and $err = 1, last;
            not $time and @vals != 3 and @vals != 2 and $err = 1, last;
            $v[3] = shift(@vals);
            $v[4] = shift(@vals) || 0;
            $v[5] = shift(@vals) || 0;
        }
        $err = 0;
    }
    return 0 if $err or not @v;
    if ($time) {
        $v[0] = $v[1] = $v[2] = 0 if defined $$time[0] and not defined $v[0];
        $v[3] = $v[4] = $v[5] = 0 if defined $$time[3] and not defined $v[3];
        $v[6] = $v[7] = 0 if defined $$time[6] and not defined $v[6];
    }
    @$vals = @v;
    return 1;
}

sub ShiftComponents($$$$$;$) {
    my ( $time, $shift, $dir, $toTime, $dec, $rndPt ) = @_;
    my @min = ( 0,     1,  1,  0,  0,  0 );
    my @max = ( 10000, 12, 28, 24, 60, 60 );
    my $i;
    my $c = 0;
    for ( $i = 0 ; $i < @$time ; ++$i ) {
        my $v = ( $$time[$i] || 0 ) + $dir * ( $$shift[$i] || 0 ) + $c;
        if ( $v != int($v) and $i < 5 ) {
            my $iv = int($v);
            $c = ( $v - $iv ) * $max[ $i + 1 ];
            $v = $iv;
        }
        else {
            $c = 0;
        }
        $$toTime[$i] = $v;
    }
    my $sec = $$toTime[5];
    if ( defined $sec and $sec != int($sec) ) {
        my $mult   = 10**$dec;
        my $rndSec = int( $sec * $mult + 0.5 * ( $sec <=> 0 ) ) / $mult;
        $rndPt and $$rndPt = $sec - $rndSec;
        $$toTime[5] = $rndSec;
    }
    $c = 0;
    for ( $i = 5 ; $i >= 0 ; $i-- ) {
        defined $$time[$i] or $c = 0, next;
        my $v = $$toTime[$i] + $c;
        $c = 0;

        my ( $min, $max ) = ( $min[$i], $max[$i] );
        if ( $v < $min ) {
            if ( $i == 2 ) {
                do {
                    --$c;
                    my $mon = $$toTime[ $i - 1 ] + $c;
                    $v += DaysInMonth( $mon, $$toTime[ $i - 2 ] );
                } while ( $v < 1 );
            }
            else {
                my $fc = ( $v - $min ) / $max;
                $c = int($fc);
                --$c if $c > $fc;
                $v -= $c * $max;
            }
        }
        elsif ( $v >= $max + $min ) {
            if ( $i == 2 ) {
                for ( ; ; ) {
                    my $mon  = $$toTime[ $i - 1 ] + $c;
                    my $days = DaysInMonth( $mon, $$toTime[ $i - 2 ] );
                    last if $v <= $days;
                    $v -= $days;
                    ++$c;
                    last if $v <= 28;
                }
            }
            else {
                my $fc = ( $v - $max - $min ) / $max;
                $c = int($fc);
                ++$c if $c <= $fc;
                $v -= $c * $max;
            }
        }
        $$toTime[$i] = $v;
    }
    if ( defined $$toTime[6] ) {
        my $m = $$toTime[6] * 60 + $$toTime[7];
        $m += 0.5 * ( $m <=> 0 );
        $$toTime[6] = int( $m / 60 );
        $$toTime[7] = int( $m - $$toTime[6] * 60 );
    }
    return undef;
}

sub ShiftNumber($$$;$) {
    my ( $val, $shift, $dir ) = @_;
    $_[0] = $val + $shift * $dir;
    return undef;
}

sub ShiftTime($;$$$) {
    my ( $val, $shift, $dir, $shiftOffset );
    my ( @time, @shift, @toTime, $mode, $needShiftOffset, $dec );

    if ( @_ == 1 ) {
        $val   = $_;
        $shift = $_[0];
    }
    else {
        ( $val, $shift, $dir, $shiftOffset ) = @_;
    }
    $dir or $dir = ( $shift =~ s/^(\+|-)// and $1 eq '-' ) ? -1 : 1;
    SplitTime( $val, \@time ) or return "Invalid time string ($val)";
    if ( defined $time[0] ) {
        return "Can't shift from year 0000" if $time[0] eq '0000';
        $mode = defined $time[3] ? 'DateTime' : 'Date';
    }
    elsif ( defined $time[3] ) {
        $mode = 'Time';
    }
    else {
        $mode = '';
    }
    if ( defined $time[5] and $time[5] =~ /\.(\d+)/ ) {
        $dec = length($1);
    }
    else {
        $dec = 0;
    }
    if ($shiftOffset) {
        $needShiftOffset = 1 unless defined $$shiftOffset{$mode};
        $needShiftOffset = 1
          if defined $time[6] and not defined $$shiftOffset{Timezone};
    }
    else {
        $needShiftOffset = 1;
    }
    if ($needShiftOffset) {
        SplitTime( $shift, \@shift, \@time )
          or return "Invalid shift string ($shift)";

        if ( @shift > 6 and @time <= 6 ) {
            $time[6] = $time[7] = 0 if $val =~ s/Z$/\+00:00/;
        }
        my $rndDiff;
        my $err =
          ShiftComponents( \@time, \@shift, $dir, \@toTime, $dec, \$rndDiff );
        $err and return $err;
        if ($shiftOffset) {
            if ( defined $time[0] or defined $time[3] ) {
                my @tm1 = ( 0, 0, 0, 1, 0, 2000 );
                my @tm2 = ( 0, 0, 0, 1, 0, 2000 );
                if ( defined $time[0] ) {
                    @tm1[ 3 .. 5 ] = reverse @time[ 0 .. 2 ];
                    @tm2[ 3 .. 5 ] = reverse @toTime[ 0 .. 2 ];
                    --$tm1[4];
                    --$tm2[4];
                }
                my $diff = 0;
                if ( defined $time[3] ) {
                    @tm1[ 0 .. 2 ] = reverse @time[ 3 .. 5 ];
                    @tm2[ 0 .. 2 ] = reverse @toTime[ 3 .. 5 ];
                    $diff =
                      $tm2[0] - int( $tm2[0] ) - ( $tm1[0] - int( $tm1[0] ) );
                    $diff += $rndDiff if defined $rndDiff;
                    $tm1[0] = int( $tm1[0] );
                    $tm2[0] = int( $tm2[0] );
                }
                eval q{
                    require Time::Local;
                    $diff += Time::Local::timegm(@tm2) - Time::Local::timegm(@tm1);
                };
                unless ($@) {
                    my $mode;
                    if ( defined $time[0] ) {
                        $mode = defined $time[3] ? 'DateTime' : 'Date';
                    }
                    else {
                        $mode = 'Time';
                    }
                    $$shiftOffset{$mode} = $diff;
                }
            }
            if ( defined $time[6] ) {
                $$shiftOffset{Timezone} =
                  ( $toTime[6] - $time[6] ) * 60 + $toTime[7] - $time[7];
            }
        }

    }
    else {
        if ( $$shiftOffset{Timezone} and @time <= 6 ) {
            $time[6] = $time[7] = 0 if $val =~ s/Z$/\+00:00/;
        }
        if ($mode) {
            my @tm = ( 0, 0, 0, 1, 0, 2000 );
            if ( defined $time[0] ) {
                @tm[ 3 .. 5 ] = reverse @time[ 0 .. 2 ];
                --$tm[4];
            }
            @tm[ 0 .. 2 ] = reverse @time[ 3 .. 5 ] if defined $time[3];
            my $frac = $tm[0] - int( $tm[0] );
            $tm[0] = int( $tm[0] );
            my $tm;
            eval q{
                require Time::Local;
                $tm = Time::Local::timegm(@tm) + $frac;
            };
            $@ and return CleanWarning($@);
            $tm += $$shiftOffset{$mode};

            $frac = $tm - int($tm);
            if ($frac) {
                $tm = int($tm);
                $frac + 0.5 * 10**( -$dec ) >= 1 and ++$tm, $frac = 0;
            }
            @tm     = gmtime($tm);
            @toTime = reverse @tm[ 0 .. 5 ];
            $toTime[0] += 1900;
            ++$toTime[1];
            $toTime[5] += $frac;
        }
        if ( defined $time[6] ) {
            my $m = $time[6] * 60 + $time[7];
            $m += $$shiftOffset{Timezone};
            $m += 0.5 * ( $m <=> 0 );
            $toTime[6] = int( $m / 60 );
            $toTime[7] = int( $m - $toTime[6] * 60 );
        }
    }
    my $i;
    for ( $i = 0 ; $i < @toTime ; ++$i ) {
        next unless defined $time[$i] and defined $toTime[$i];
        my ( $v, $d, $s );
        if ( $i != 6 ) {
            last unless $val =~ /((?=\d|\.\d)\d*(\.\d*)?)/g;
            next if $toTime[$i] == $time[$i];
            $v = $1;
            $d = $2;
            $s = '';
        }
        else {
            last
              if $time[$i] == $toTime[$i]
              and $time[ $i + 1 ] == $toTime[ $i + 1 ];
            last unless $val =~ /((?:\+|-)(?=\d|\.\d)\d*(\.\d*)?)/g;
            $v = $1;
            $d = $2;
            if ( $toTime[6] >= 0 and $toTime[7] >= 0 ) {
                $s = '+';
            }
            else {
                $s         = '-';
                $toTime[6] = -$toTime[6];
                $toTime[7] = -$toTime[7];
            }
        }
        my $nv     = $toTime[$i];
        my $pos    = pos $val;
        my $len    = length $v;
        my $sig    = $len - length $s;
        my $dec    = $d ? length($d) - 1 : 0;
        my $newNum = sprintf( $dec ? "$s%0$sig.${dec}f" : "$s%0${sig}d", $nv );
        substr( $val, $pos - $len, $len ) = $newNum;
        pos($val) = $pos + length($newNum) - $len;
    }
    if ( @_ == 1 ) {
        $_ = $val;
    }
    else {
        $_[0] = $val;
    }
    return undef;
}

1;

__END__


