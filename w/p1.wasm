    0x100 => { Name => 'RawDevExposureBiasValue', Writable => 'rational64s' },
    0x101 => { Name => 'RawDevWhiteBalanceValue', Writable => 'int16u' },
    0x102 => { Name => 'RawDevWBFineAdjustment',  Writable => 'int16s' },
