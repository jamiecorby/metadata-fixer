        },
    },
    9.1 => {
        Name      => 'ExposureDelayMode',
        Mask      => 0x40,
        PrintConv => \%offOn,
    },
    11.1 => {
        Name      => 'AutoBracketSet',
        Mask      => 0xc0,
        PrintConv => {
