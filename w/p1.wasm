%afStatusInfo = (
    Format => 'int16s',
    PrintConvColumns => 2,
    PrintConv        => {
        0      => 'In Focus',
        -32768 => 'Out of Focus',
        OTHER  => sub {
            my ( $val, $inv ) = @_;
            $inv and $val =~ /([-+]?\d+)/, return $1;
            return $val < 0 ? "Front Focus ($val)" : "Back Focus (+$val)";
        },
    },
);

