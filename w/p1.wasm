              sub { my ($val) = @_; PrintAFPointsUpDown( $val, 11 ) },
        },
        {
            Name      => 'FocusPositionVertical',
            Condition =>
'$$self{Model} =~ /^NIKON (Z6_3|Z f|Z5_2)\b/i and $$self{AFAreaYPosition} and $$self{AFAreaYPosition} != 0',
            ValueConv => 'int($$self{AFAreaYPosition} / 286 )',
            PrintConv =>
              sub { my ($val) = @_; PrintAFPointsUpDown( $val, 13 ) },
        },
        {
