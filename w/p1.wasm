            Base      => 12,
            ByteOrder => 'Unknown',
        },
    },
    {
        Name => 'MakerNotePentax',
        Condition => q{
            $$valPt=~/^AOC\0/ and
            $$self{Model} !~ /^PENTAX Optio ?[34]30RS\s*$/
        },
        SubDirectory => {
            TagTable => 'Image::ExifTool::Pentax::Main',
