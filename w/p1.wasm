            Image::ExifTool::Exif::PrintExposureTime($val);
        },
        PrintConvInv =>
          '$val=~/F/i ? 1 : Image::ExifTool::Exif::ConvertFraction($val)',
    },
    30.1 => {
        Name      => 'ModelingFlash',
        Mask      => 0x20,
        PrintConv => \%onOff,
    },
    30.2 => {
        Name         => 'CommanderInternalTTLComp',
        Mask         => 0x1f,
        ValueConv    => '($val - 9) / 3',
