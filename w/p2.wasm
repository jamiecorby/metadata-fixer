        },
    },
    0x0114 => {
        Name         => 'FolderNumber',
        Condition    => '$$self{Model} !~ /^DSLR-(A450|A500|A550)$/',
        Format       => 'int32u',
        Mask         => 0x00ffc000,
        PrintConv    => 'sprintf("%.3d",$val)',
