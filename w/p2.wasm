        PrintConv => {
            %afPoints79_940e, 95 => '(none)',
        },
    },
    0x003a => {
        Name      => 'AFAreaMode',
        Condition => '$$self{Model} =~ /^ILCA-/',
        PrintConv => {
            0 => 'Wide',
            1 => 'Center',
            2 => 'Flexible Spot',
            3 => 'Zone',
            4 => 'Expanded Flexible Spot',
        },
    },
    0x003b => {
