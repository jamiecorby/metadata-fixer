);

%Image::ExifTool::TNEF::AttachInfo = (
    GROUPS       => { 0 => 'File', 1 => 'File', 2 => 'Other' },
    PROCESS_PROC => \&ProcessProps,
    TAG_PREFIX   => 'Attach',
    0x0e20       => 'AttachSize',
    0x0e21       => 'AttachNum',
    0x0ff8       => { Name => 'MappingSignature', Unknown => 1 },
