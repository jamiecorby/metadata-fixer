my %sonyDateTime2010 = (
    Name      => 'SonyDateTime',
    Format    => 'undef[7]',
    Shift     => 'Time',
    ValueConv => q{
        my @v = unpack('vC*', $val);
        return sprintf("%.4d:%.2d:%.2d %.2d:%.2d:%.2d", @v)
    },
    ValueConvInv => q{
        my @v = ($val =~ /\d+/g);
        return undef unless @v == 6;
        return pack('vC*', @v);
    },
    PrintConv    => '$self->ConvertDateTime($val)',
    PrintConvInv => '$self->InverseDateTime($val,0)',
);
my %releaseMode2010 = (
    Name      => 'ReleaseMode3',
    PrintConv => {
        0 => 'Normal',
        1 => 'Continuous',
        2 => 'Bracketing',

        4 => 'Continuous - Burst',
        5 => 'Continuous - Speed/Advance Priority',
        6 => 'Normal - Self-timer',
        9 => 'Single Burst Shooting',
    },
);
