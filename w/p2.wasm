        %Image::ExifTool::Minolta::afStatusInfo
    },
    0x001d =>
      { Name => 'AFStatusTop-right', %Image::ExifTool::Minolta::afStatusInfo },
    0x001f => {
        Name => 'AFStatusBottom-right',
        %Image::ExifTool::Minolta::afStatusInfo
    },
    0x0021 =>
      { Name => 'AFStatusBottom', %Image::ExifTool::Minolta::afStatusInfo },
